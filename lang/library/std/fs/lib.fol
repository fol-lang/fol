// Filesystem reads.

use vecs: loc = {"../vecs"};

fun[exp] dir_list(path: str): str = {
    return .dir_list(path);
};

fun[exp] read_file(path: str): str = {
    return .read_file(path);
};

fun[exp] write_file(path: str, contents: str): int = {
    return .write_file(path, contents);
};

// Streaming file access.
//
// `read_file`/`read_bytes` load a whole file, so a file larger than memory, or
// one still being written, cannot be handled at all. These open a handle and
// move through it instead.
//
// Modes are integers because FOL types a one-character double-quoted literal
// as `chr`, so `.file_open(path, "r")` does not typecheck. These names exist so
// callers never have to remember which number is which.

con[exp] MODE_READ: int = 0;
con[exp] MODE_WRITE: int = 1;
con[exp] MODE_APPEND: int = 2;
con[exp] MODE_UPDATE: int = 3;

con[exp] FROM_START: int = 0;
con[exp] FROM_HERE: int = 1;
con[exp] FROM_END: int = 2;

fun[exp] open_read(path: str): int = {
    return .file_open(path, MODE_READ);
};

fun[exp] open_write(path: str): int = {
    return .file_open(path, MODE_WRITE);
};

fun[exp] open_append(path: str): int = {
    return .file_open(path, MODE_APPEND);
};

fun[exp] open_update(path: str): int = {
    return .file_open(path, MODE_UPDATE);
};

fun[exp] read_chunk(handle: int, count: int): vec[int] = {
    return .file_read(handle, count);
};

fun[exp] write_chunk(handle: int, bytes: vec[int]): int = {
    return .file_write(handle, bytes);
};

fun[exp] write_text(handle: int, text: str): int = {
    return .file_write(handle, .str_bytes(text));
};

fun[exp] seek(handle: int, offset: int, whence: int): int = {
    return .file_seek(handle, offset, whence);
};

fun[exp] rewind(handle: int): int = {
    return .file_seek(handle, 0, FROM_START);
};

fun[exp] flush(handle: int): int = {
    return .file_flush(handle);
};

fun[exp] close(handle: int): int = {
    return .file_close(handle);
};

// Carries the bytes of a character that a chunk boundary split in half.
//
// Feeding a raw chunk straight to `.str_from_bytes` is the trap: a boundary
// that lands inside a multi-byte character makes the whole chunk invalid, and
// it decodes to "" -- reading `héllo` two bytes at a time yields `lo`. Decoding
// only the complete prefix and holding the remainder is what makes a chunked
// read lossless.
typ[exp] Decoder: rec = {
    carry: vec[int],
    text: str,
};

fun[exp] decoder(): Decoder = {
    return { carry = {}, text = "" };
};

fun[exp] feed(state: Decoder, chunk: vec[int]): Decoder = {
    var pending: vec[int] = vecs::concat(state.carry, chunk);
    var ready: int = .utf8_prefix_len(pending);
    var total: int = .len(pending);
    // A zero-length prefix on a non-empty buffer is either a genuinely
    // malformed byte or a sequence still arriving; holding it is correct for
    // the second and harmless for the first, which `.str_from_bytes` then
    // reports as empty at the end.
    var decoded: str = .str_from_bytes(vecs::slice(pending, 0, ready));
    var rest: vec[int] = vecs::slice(pending, ready, total - ready);
    return { carry = rest, text = decoded };
};

// Reads a whole file through a fixed-size window, never holding more than one
// chunk plus a partial character.
fun[exp] read_streamed(path: str, chunk: int): str = {
    var handle: int = open_read(path);
    if (handle < 0) {
        return "";
    } else {
    };
    var[mut] state: Decoder = decoder();
    var[mut] out: str = "";
    var[mut] going: bol = true;
    loop (going) {
        var piece: vec[int] = .file_read(handle, chunk);
        if (.len(piece) == 0) {
            going = false;
        } else {
            state = feed(state, piece);
            out = out + state.text;
        };
    };
    var done: int = close(handle);
    return out;
};

// The absolute path with symlinks and `..` resolved ON DISK.
//
// `std::path::normalize` resolves `..` textually, which is a different answer
// whenever a symlink is involved — so it cannot decide whether a path stays
// inside an allowed directory. This asks the filesystem, so the path must
// already exist. Empty string on failure, with the reason in `std::os::error`.
fun[exp] resolve(path: str): str = {
    return .realpath(path);
};

// Creates a uniquely named empty file in the temp directory and returns its
// path. The create is the point: choosing a name and then opening it would
// race, because another process could take the name in between.
fun[exp] temp_path(prefix: str): str = {
    return .temp_file(prefix);
};

// Write a file so a reader never sees a half-written one: write a temp file,
// then rename it over the target. Rename is atomic within a filesystem, which
// is why the temp file has to be made in the same directory as the target
// rather than in the temp directory.
fun[exp] write_atomic(path: str, contents: str): int = {
    var scratch: str = .temp_file("fol-atomic-");
    if (.len(scratch) == 0) {
        return 0 - 1;
    } else {
    };
    if (.write_file(scratch, contents) != 0) {
        var discarded: int = .remove_file(scratch);
        return 0 - 1;
    } else {
    };
    return .rename_file(scratch, path);
};

fun[exp] make_link(target: str, link: str): int = {
    return .make_symlink(target, link);
};

// Advisory whole-file locking, which is how a program stays single-instance:
// take an exclusive lock on a known path and exit if another process holds it.
//
// Advisory means it only binds processes that also ask; it does not stop an
// unrelated writer.
fun[exp] lock_exclusive(handle: int): int = {
    return .file_lock(handle, true, true);
};

// Returns -1 immediately instead of blocking, so a caller can report "already
// running" rather than hang.
fun[exp] try_lock_exclusive(handle: int): int = {
    return .file_lock(handle, true, false);
};

fun[exp] lock_shared(handle: int): int = {
    return .file_lock(handle, false, true);
};

fun[exp] unlock(handle: int): int = {
    return .file_unlock(handle);
};
