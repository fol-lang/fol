fun[exp] sleep_ms(ms: int): int = {
    return .sleep_ms(ms);
};

fun[exp] now_ms(): int = {
    return .now_ms();
};

// Seconds to add to UTC for local time. `.time_parts` works in UTC, so without
// this every timestamp a program shows its reader is wrong.
//
// Takes the instant because the offset is not a constant: the same zone is
// +3600 in January and +7200 in July.
fun[exp] local_offset(epoch_secs: int): int = {
    return .tz_offset_sec(epoch_secs);
};

// `.time_parts` reads **milliseconds**; the argument here is seconds, like the
// rest of this module, so the shifted instant is scaled on the way in.
fun[exp] local_parts(epoch_secs: int): vec[int] = {
    return .time_parts((epoch_secs + .tz_offset_sec(epoch_secs)) * 1000);
};
