// Ordering and search over vectors, written in FOL over indexed reads, indexed
// writes and `.len`.
//
// These are generic over the element type. Two bounds carry the module: `clone`,
// because a pure routine has to copy elements out of its argument rather than
// move them, and `ord`, which promises a total order and therefore also decides
// equality.
//
// A name that still ends in `_int` or `_flt` is one that genuinely cannot be
// generic. FOL has no numeric capability bound, so `+` is unavailable on a `T`;
// and `ord` means a TOTAL order, which `flt` does not have. The suffix marks a
// real restriction rather than work not yet done.

// Delegates to the native sort. The FOL insertion sort this replaced was
// O(n-squared), and every routine built on it inherited that.
fun[exp] sort(T: ord + clone)(values: vec[T]): vec[T] = {
    var[mut] out: vec[T] = [mov]values;
    out.sort();
    return out;
};

// Floats cannot go through `sort`: the `ord` bound promises a total order and
// `flt` has none, because NaN compares equal to nothing. The container method
// needs only a partial order, which `flt` does have, so this sorts directly.
// NaN is treated as equal to its neighbours, which keeps the sort total and
// terminating rather than correct about NaN.
fun[exp] sort_flt(values: vec[flt]): vec[flt] = {
    var[mut] out: vec[flt] = [mov]values;
    out.sort();
    return out;
};

fun[exp] reverse(T: clone)(values: vec[T]): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = .len(values) - 1;
    loop (i >= 0) {
        out.push([cln]values[i]);
        i = i - 1;
    };
    return out;
};

fun[exp] is_sorted(T: ord + clone)(values: vec[T]): bol = {
    var[mut] i: int = 1;
    loop (i < .len(values)) {
        if (values[i - 1] > values[i]) {
            return false;
        } else {
        };
        i = i + 1;
    };
    return true;
};

// Linear scan, so it works on any vector; -1 when absent.
fun[exp] index_of(T: ord + clone)(values: vec[T], needle: T): int = {
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (values[i] == needle) {
            return i;
        } else {
        };
        i = i + 1;
    };
    return 0 - 1;
};

fun[exp] contains(T: ord + clone)(values: vec[T], needle: T): bol = {
    return index_of(values, [cln]needle) >= 0;
};

// Halving search, so it requires a sorted input; `is_sorted` can confirm one.
fun[exp] binary_search(T: ord + clone)(values: vec[T], needle: T): int = {
    var[mut] low: int = 0;
    var[mut] high: int = .len(values) - 1;
    loop (low <= high) {
        var mid: int = low + (high - low) / 2;
        if (values[mid] == needle) {
            return mid;
        } else {
            if (values[mid] < needle) {
                low = mid + 1;
            } else {
                high = mid - 1;
            };
        };
    };
    return 0 - 1;
};

// The fallback is an argument because an empty vector has no smallest element.
fun[exp] min_of(T: ord + clone)(values: vec[T], fallback: T): T = {
    if (.len(values) == 0) {
        return [cln]fallback;
    } else {
    };
    var[mut] best: T = [cln]values[0];
    var[mut] i: int = 1;
    loop (i < .len(values)) {
        if (values[i] < best) {
            best = [cln]values[i];
        } else {
        };
        i = i + 1;
    };
    return best;
};

fun[exp] max_of(T: ord + clone)(values: vec[T], fallback: T): T = {
    if (.len(values) == 0) {
        return [cln]fallback;
    } else {
    };
    var[mut] best: T = [cln]values[0];
    var[mut] i: int = 1;
    loop (i < .len(values)) {
        if (values[i] > best) {
            best = [cln]values[i];
        } else {
        };
        i = i + 1;
    };
    return best;
};

fun[exp] fill(T: clone)(count: int, value: T): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < count) {
        out.push([cln]value);
        i = i + 1;
    };
    return out;
};

// Clamps rather than faulting: a start past the end yields an empty vector.
fun[exp] slice(T: clone)(values: vec[T], start: int, count: int): vec[T] = {
    var[mut] out: vec[T] = {};
    var total: int = .len(values);
    var[mut] i: int = start;
    var stop: int = start + count;
    loop (i < stop and i < total) {
        if (i >= 0) {
            out.push([cln]values[i]);
        } else {
        };
        i = i + 1;
    };
    return out;
};

fun[exp] concat(T: clone)(left: vec[T], right: vec[T]): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(left)) {
        out.push([cln]left[i]);
        i = i + 1;
    };
    var[mut] j: int = 0;
    loop (j < .len(right)) {
        out.push([cln]right[j]);
        j = j + 1;
    };
    return out;
};

// Requires a sorted input, which is what makes one pass enough.
fun[exp] dedup_sorted(T: ord + clone)(values: vec[T]): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (i == 0) {
            out.push([cln]values[i]);
        } else {
            if (values[i] == values[i - 1]) {
            } else {
                out.push([cln]values[i]);
            };
        };
        i = i + 1;
    };
    return out;
};

// Integers specifically: `+` needs a numeric bound, which FOL does not have.
fun[exp] sum_int(values: vec[int]): int = {
    var[mut] total: int = 0;
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        total = total + values[i];
        i = i + 1;
    };
    return total;
};

// Half-open, and integers by nature: it generates the values rather than
// copying them out of an argument.
fun[exp] range_int(start: int, stop: int): vec[int] = {
    var[mut] out: vec[int] = {};
    var[mut] i: int = start;
    loop (i < stop) {
        out.push(i);
        i = i + 1;
    };
    return out;
};
