// The std package root mounts the modules; the routines themselves live in
// their own modules (`std::os`, `std::fs`, `std::io`, …) rather than being
// dumped here.
use os: loc = {"os"};
use fs: loc = {"fs"};
use vecs: loc = {"vecs"};
use chars: loc = {"chars"};
use path: loc = {"path"};
use iter: loc = {"iter"};
use sets: loc = {"sets"};
use codec: loc = {"codec"};
use hash: loc = {"hash"};
use nums: loc = {"nums"};
use grid: loc = {"grid"};
use heap: loc = {"heap"};
