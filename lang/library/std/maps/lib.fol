// Iteration and set-like operations over `map[K, V]`, written in FOL.
//
// FOL has no tuple value, but it does have records, and a record IS a pair — so
// key/value iteration needs no new language surface. `keys()` gives the key
// order (sorted, because the backing store is a `BTreeMap`) and `get()` reads
// each value.
//
// Generic over both parameters. `K` needs `ord` because it is a map key, and
// `clone` because a pure routine copies keys out rather than moving them out of
// the caller's map. Where a routine also compares values, `V` needs `ord` too.
//
// A routine whose value type is fixed to `int` is doing arithmetic on it: FOL
// has no numeric capability bound, so `+` is unavailable on a `V`. Those are
// still generic over the KEY.

typ[exp] Pair(K, V): rec = {
    key: K,
    value: V,
};

// Every `.get()` here is read straight into `when` rather than through a local
// binding. A local holding an `opt[V]` is one Rust binding for the whole
// routine, so consuming it inside a loop moves the same value twice — which a
// concrete `opt[int]` survives by being `Copy` and a generic `opt[V]` does not.
fun[exp] pairs(K: ord + clone, V: clone)(source: map[K, V]): vec[Pair[K, V]] = {
    var[mut] out: vec[Pair[K, V]] = {};
    var names: vec[K] = source.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        when(source.get([cln]names[i])) {
            on(value) { out.push({ key = [cln]names[i], value = value }); }
            * { }
        }
        i = i + 1;
    };
    return out;
};

fun[exp] get_or(K: ord + clone, V: clone)(source: map[K, V], key: K, fallback: V): V = {
    when(source.get([cln]key)) {
        on(value) { return value; }
        * { return [cln]fallback; }
    }
};

fun[exp] has_key(K: ord + clone, V: clone)(source: map[K, V], key: K): bol = {
    when(source.get([cln]key)) {
        on(value) { return true; }
        * { return false; }
    }
};

// Later entries win, matching how `insert` behaves on a duplicate key.
fun[exp] merge(K: ord + clone, V: clone)(left: map[K, V], right: map[K, V]): map[K, V] = {
    var[mut] out: map[K, V] = [mov]left;
    var names: vec[K] = right.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        when(right.get([cln]names[i])) {
            on(value) { out.insert([cln]names[i], value); }
            * { }
        }
        i = i + 1;
    };
    return out;
};

// Values become keys, so `V` has to be orderable as well. Two keys sharing a
// value collapse to one entry, and which one survives follows key order.
fun[exp] invert(K: ord + clone, V: ord + clone)(source: map[K, V]): map[V, K] = {
    var[mut] out: map[V, K] = {};
    var names: vec[K] = source.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        when(source.get([cln]names[i])) {
            on(value) { out.insert(value, [cln]names[i]); }
            * { }
        }
        i = i + 1;
    };
    return out;
};

fun[exp] keys_where(K: ord + clone, V: ord + clone)(source: map[K, V], least: V): vec[K] = {
    var[mut] out: vec[K] = {};
    var names: vec[K] = source.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        when(source.get([cln]names[i])) {
            on(value) {
                if (value >= least) {
                    out.push([cln]names[i]);
                } else {
                };
            }
            * { }
        }
        i = i + 1;
    };
    return out;
};

fun[exp] values_of(K: ord + clone, V: clone)(source: map[K, V]): vec[V] = {
    var[mut] out: vec[V] = {};
    var names: vec[K] = source.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        when(source.get([cln]names[i])) {
            on(value) { out.push(value); }
            * { }
        }
        i = i + 1;
    };
    return out;
};

// Add `amount` to the value at `key`, starting from zero when it is absent.
// This is the counting idiom every word-frequency and histogram pass wants.
//
// The value is `int` because the routine adds; the key stays generic.
fun[exp] bump(K: ord + clone)(source: map[K, int], key: K, amount: int): map[K, int] = {
    var[mut] out: map[K, int] = [mov]source;
    var current: int = get_or(out, [cln]key, 0);
    out.insert([cln]key, current + amount);
    return out;
};

// A frequency table over anything orderable, not only strings.
fun[exp] tally(K: ord + clone)(items: vec[K]): map[K, int] = {
    var[mut] out: map[K, int] = {};
    var[mut] i: int = 0;
    loop (i < .len(items)) {
        out = bump([mov]out, [cln]items[i], 1);
        i = i + 1;
    };
    return out;
};

fun[exp] sum_values(K: ord + clone)(source: map[K, int]): int = {
    var[mut] total: int = 0;
    var names: vec[K] = source.keys();
    var[mut] i: int = 0;
    loop (i < .len(names)) {
        total = total + get_or(source, [cln]names[i], 0);
        i = i + 1;
    };
    return total;
};
