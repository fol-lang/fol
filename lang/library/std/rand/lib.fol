// A seeded pseudo-random generator, written in FOL over the bitwise ops.
//
// `.random_int`/`.random_bytes` reach the operating system and are therefore
// unpredictable and unrepeatable. This is the opposite tool: same seed, same
// sequence, every run — which is what tests, simulations and procedural
// generation need. Seed it from `from_os()` when you want both.
//
// The generator is xorshift64* — Vigna's shift triple 12/25/27 over a full
// 64-bit state, with the output passed through a multiplicative scrambler.
// That final multiply is the whole point: plain xorshift has visibly weak low
// bits, so anything reduced with `%` (a die roll, a bucket index, a coin flip)
// inherits the weakness. The multiply mixes the high bits down.
//
// Not cryptography. Its state is recoverable from its output, which is exactly
// what makes it repeatable. Use `.random_bytes` when unpredictability matters.

con MULTIPLIER: int = 2685821657736338717;
con MASK63: int = 9223372036854775807;
con SEED_FALLBACK: int = 88172645463325252;

// FOL's `shr` is arithmetic: it fills from the sign bit, so shifting a negative
// state right would smear ones through the top. Masking away the bits the sign
// filled in turns it into the logical shift the recurrence is defined over,
// which is what lets the state use all 64 bits instead of only 63.
con MASK_SHR12: int = 4503599627370495;
con MASK_SHR27: int = 137438953471;

typ[exp] Rng: rec = {
    state: int,
};

// Returning the advanced generator alongside the value is how a pure routine
// carries state; a record is the pair.
typ[exp] Draw: rec = {
    rng: Rng,
    value: int,
};

typ[exp] DrawVec: rec = {
    rng: Rng,
    values: vec[int],
};

// A zero seed is a fixed point for xorshift — it would emit zeros forever — so
// it is replaced rather than silently producing a dead stream. Any other seed
// is taken as given, including a negative one: the state is genuinely 64-bit.
fun[exp] seeded(seed: int): Rng = {
    if (seed == 0) {
        return { state = SEED_FALLBACK };
    } else {
    };
    return { state = seed };
};

fun[exp] from_os(): Rng = {
    return seeded(.random_int(1, MASK63));
};

fun[exp] next(rng: Rng): Draw = {
    var[mut] x: int = rng.state;
    x = .bit_xor(x, .bit_and(.shr(x, 12), MASK_SHR12));
    x = .bit_xor(x, .shl(x, 25));
    x = .bit_xor(x, .bit_and(.shr(x, 27), MASK_SHR27));
    if (x == 0) {
        x = SEED_FALLBACK;
    } else {
    };
    // The scrambler applies to the OUTPUT only; feeding it back would change
    // the recurrence and cost the proven period. Masking to 63 bits drops just
    // the sign bit, keeping the well-mixed high bits, so callers can reduce the
    // value with `%` without meeting a negative.
    var scrambled: int = .bit_and(.wrapping_mul(x, MULTIPLIER), MASK63);
    return { rng = { state = x }, value = scrambled };
};

// Uniform in `[low, high)`. Uses rejection like the OS version rather than a
// modulo, so the low end is not favoured when the range does not divide evenly.
fun[exp] next_range(rng: Rng, low: int, high: int): Draw = {
    if (high <= low) {
        return { rng = rng, value = low };
    } else {
    };
    var span: int = high - low;
    var limit: int = MASK63 - (MASK63 % span);
    var[mut] step: Draw = next(rng);
    loop (step.value >= limit) {
        step = next(step.rng);
    };
    return { rng = step.rng, value = low + (step.value % span) };
};

fun[exp] next_bool(rng: Rng): Draw = {
    var step: Draw = next(rng);
    return { rng = step.rng, value = step.value % 2 };
};

// Fisher-Yates, which is why `swap` had to exist: it is the only shuffle that
// visits every permutation with equal probability.
fun[exp] shuffle_int(rng: Rng, values: vec[int]): DrawVec = {
    var[mut] out: vec[int] = [mov]values;
    var[mut] carried: Rng = rng;
    var[mut] i: int = .len(out) - 1;
    loop (i > 0) {
        var step: Draw = next_range(carried, 0, i + 1);
        carried = step.rng;
        out.swap(i, step.value);
        i = i - 1;
    };
    return { rng = carried, values = [mov]out };
};

fun[exp] choice_int(rng: Rng, values: vec[int], fallback: int): Draw = {
    var total: int = .len(values);
    if (total == 0) {
        return { rng = rng, value = fallback };
    } else {
    };
    var step: Draw = next_range(rng, 0, total);
    return { rng = step.rng, value = values[step.value] };
};
