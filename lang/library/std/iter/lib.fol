// Eager adapters over vectors, written in FOL with routine-value parameters.
//
// Eager means each one returns a complete vector, so a chain allocates at every
// step. There is no lazy iterator protocol; for a hot loop, write the loop.
//
// Generic over the element type, and over the result type where the adapter
// changes it. `clone` is the only bound most of them need — the predicate or
// step decides everything else.

fun[exp] map_to(T: clone, U: clone)(values: vec[T], step: {fun (value: T): U}): vec[U] = {
    var[mut] out: vec[U] = {};
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        out.push(step([cln]values[i]));
        i = i + 1;
    };
    return out;
};

fun[exp] filter(T: clone)(values: vec[T], keep: {fun (value: T): bol}): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (keep([cln]values[i])) {
            out.push([cln]values[i]);
        } else {
        };
        i = i + 1;
    };
    return out;
};

// The accumulator is its own parameter, so a fold may change the type: summing
// to an `int`, or joining to a `str`.
fun[exp] fold(T: clone, A: clone)(
    values: vec[T],
    start: A,
    step: {fun (carried: A, value: T): A},
): A = {
    var[mut] carried: A = [cln]start;
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        carried = step([cln]carried, [cln]values[i]);
        i = i + 1;
    };
    return carried;
};

fun[exp] any(T: clone)(values: vec[T], test: {fun (value: T): bol}): bol = {
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (test([cln]values[i])) {
            return true;
        } else {
        };
        i = i + 1;
    };
    return false;
};

fun[exp] all(T: clone)(values: vec[T], test: {fun (value: T): bol}): bol = {
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (test([cln]values[i])) {
        } else {
            return false;
        };
        i = i + 1;
    };
    return true;
};

// -1 when nothing matches, matching `vecs::index_of`.
fun[exp] position(T: clone)(values: vec[T], test: {fun (value: T): bol}): int = {
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (test([cln]values[i])) {
            return i;
        } else {
        };
        i = i + 1;
    };
    return 0 - 1;
};

fun[exp] count_if(T: clone)(values: vec[T], test: {fun (value: T): bol}): int = {
    var[mut] total: int = 0;
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (test([cln]values[i])) {
            total = total + 1;
        } else {
        };
        i = i + 1;
    };
    return total;
};

fun[exp] take(T: clone)(values: vec[T], count: int): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < count and i < .len(values)) {
        out.push([cln]values[i]);
        i = i + 1;
    };
    return out;
};

fun[exp] skip(T: clone)(values: vec[T], count: int): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = count;
    loop (i < .len(values)) {
        if (i >= 0) {
            out.push([cln]values[i]);
        } else {
        };
        i = i + 1;
    };
    return out;
};

// Stops at the first element that fails, unlike `filter`, which tests them all.
fun[exp] take_while(T: clone)(values: vec[T], test: {fun (value: T): bol}): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        if (test([cln]values[i])) {
            out.push([cln]values[i]);
            i = i + 1;
        } else {
            return out;
        };
    };
    return out;
};

fun[exp] skip_while(T: clone)(values: vec[T], test: {fun (value: T): bol}): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    var[mut] dropping: bol = true;
    loop (i < .len(values)) {
        if (dropping) {
            if (test([cln]values[i])) {
            } else {
                dropping = false;
                out.push([cln]values[i]);
            };
        } else {
            out.push([cln]values[i]);
        };
        i = i + 1;
    };
    return out;
};

// Integers specifically: adding needs a numeric bound, which FOL does not have.
// For any other element type, pair the vectors with `fold` and supply the
// combining step yourself.
fun[exp] zip_add_int(left: vec[int], right: vec[int]): vec[int] = {
    var[mut] out: vec[int] = {};
    var[mut] i: int = 0;
    loop (i < .len(left) and i < .len(right)) {
        out.push(left[i] + right[i]);
        i = i + 1;
    };
    return out;
};
