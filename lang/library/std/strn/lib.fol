fun[exp] sub(text: str, start: int, count: int): str = {
    return .str_sub(text, start, count);
};

fun[exp] byte_at(text: str, index: int): int = {
    return .str_byte(text, index);
};

fun[exp] from_byte(value: int): str = {
    return .byte_to_str(value);
};

fun[exp] find(text: str, needle: str): int = {
    return .str_find(text, needle);
};

fun[exp] replace(text: str, from: str, to: str): str = {
    return .str_replace(text, from, to);
};

fun[exp] to_int(text: str, fallback: int): int = {
    return .parse_int(text, fallback);
};

// Most of what follows is FOL over the primitives above. The exceptions are the
// Unicode-aware ones — case mapping and trimming are TABLES, not arithmetic, so
// they forward to intrinsics rather than walking bytes. An earlier byte-walking
// `to_upper` returned "HLLO" for "héllo".

fun[exp] is_empty(text: str): bol = {
    return .len(text) == 0;
};

fun[exp] starts_with(text: str, prefix: str): bol = {
    var n: int = .len(prefix);
    if (n > .len(text)) {
        return false;
    } else {
    };
    return .str_sub(text, 0, n) == prefix;
};

fun[exp] ends_with(text: str, suffix: str): bol = {
    var n: int = .len(suffix);
    var total: int = .len(text);
    if (n > total) {
        return false;
    } else {
    };
    return .str_sub(text, total - n, n) == suffix;
};

fun[exp] contains(text: str, needle: str): bol = {
    return .str_find(text, needle) >= 0;
};

fun[exp] is_space_byte(value: int): bol = {
    return value == 32 or value == 9 or value == 10 or value == 13;
};

fun[exp] trim_start(text: str): str = {
    var source: vec[chr] = .str_chars(text);
    var total: int = .len(source);
    var[mut] start: int = 0;
    loop (start < total and .chr_is_space(source[start])) {
        start = start + 1;
    };
    return .str_sub(text, .str_char_index(text, start), .len(text));
};

fun[exp] trim_end(text: str): str = {
    var source: vec[chr] = .str_chars(text);
    var[mut] stop: int = .len(source);
    loop (stop > 0 and .chr_is_space(source[stop - 1])) {
        stop = stop - 1;
    };
    return .str_sub(text, 0, .str_char_index(text, stop));
};

fun[exp] trim(text: str): str = {
    return .str_trim(text);
};

fun[exp] to_upper(text: str): str = {
    return .str_upper(text);
};

fun[exp] to_lower(text: str): str = {
    return .str_lower(text);
};

fun[exp] repeat(text: str, times: int): str = {
    var[mut] built: str = "";
    var[mut] i: int = 0;
    loop (i < times) {
        built = built + text;
        i = i + 1;
    };
    return built;
};

// Padding counts CHARACTERS, since the point is display width.
fun[exp] pad_left(text: str, width: int, fill: str): str = {
    var missing: int = width - .str_char_len(text);
    if (missing <= 0) {
        return text;
    } else {
    };
    return repeat(fill, missing) + text;
};

fun[exp] pad_right(text: str, width: int, fill: str): str = {
    var missing: int = width - .str_char_len(text);
    if (missing <= 0) {
        return text;
    } else {
    };
    return text + repeat(fill, missing);
};

fun[exp] last_index_of(text: str, needle: str): int = {
    var n: int = .len(needle);
    var[mut] i: int = .len(text) - n;
    loop (i >= 0) {
        if (.str_sub(text, i, n) == needle) {
            return i;
        } else {
        };
        i = i - 1;
    };
    return 0 - 1;
};

fun[exp] strip_prefix(text: str, prefix: str): str = {
    if (starts_with(text, prefix)) {
        var n: int = .len(prefix);
        return .str_sub(text, n, .len(text) - n);
    } else {
    };
    return text;
};

fun[exp] strip_suffix(text: str, suffix: str): str = {
    if (ends_with(text, suffix)) {
        return .str_sub(text, 0, .len(text) - .len(suffix));
    } else {
    };
    return text;
};

// Reverses CHARACTERS. The byte-wise version this replaces dropped every
// multi-byte character silently.
fun[exp] reverse(text: str): str = {
    var source: vec[chr] = .str_chars(text);
    var[mut] out: vec[chr] = {};
    var[mut] i: int = .len(source) - 1;
    loop (i >= 0) {
        out.push(source[i]);
        i = i - 1;
    };
    return .str_from_chars(out);
};

// An empty separator would never advance, so it yields the whole text as one
// part rather than looping forever.
fun[exp] split(text: str, sep: str): vec[str] = {
    var[mut] parts: vec[str] = {};
    var width: int = .len(sep);
    if (width == 0) {
        parts.push(text);
        return parts;
    } else {
    };
    var[mut] rest: str = text;
    var[mut] hit: int = .str_find(rest, sep);
    loop (hit >= 0) {
        parts.push(.str_sub(rest, 0, hit));
        var used: int = hit + width;
        rest = .str_sub(rest, used, .len(rest) - used);
        hit = .str_find(rest, sep);
    };
    parts.push(rest);
    return parts;
};

fun[exp] lines(text: str): vec[str] = {
    return split(text, "
");
};

fun[exp] join(parts: vec[str], sep: str): str = {
    var[mut] built: str = "";
    var[mut] i: int = 0;
    var total: int = .len(parts);
    loop (i < total) {
        if (i > 0) {
            built = built + sep;
        } else {
        };
        built = built + parts[i];
        i = i + 1;
    };
    return built;
};

fun[exp] count_matches(text: str, needle: str): int = {
    var width: int = .len(needle);
    if (width == 0) {
        return 0;
    } else {
    };
    var[mut] found: int = 0;
    var[mut] rest: str = text;
    var[mut] hit: int = .str_find(rest, needle);
    loop (hit >= 0) {
        found = found + 1;
        var used: int = hit + width;
        rest = .str_sub(rest, used, .len(rest) - used);
        hit = .str_find(rest, needle);
    };
    return found;
};

// Unicode normalization.
//
// `é` typed as `e` plus a combining accent and `é` typed precomposed look
// identical, compare unequal, and report different lengths. Any comparison of
// text a person typed -- a login name, a search box, a filename -- has to
// normalize both sides first or it will reject input the user believes is
// correct.
//
// Prefer `nfc` for storing and comparing. `nfkc` additionally folds
// compatibility variants (`ﬁ` becomes `fi`, fullwidth `Ａ` becomes `A`), which
// is right for a search key and wrong for text handed back to the user,
// because it discards distinctions the author made.

con FORM_NFC: int = 0;
con FORM_NFD: int = 1;
con FORM_NFKC: int = 2;
con FORM_NFKD: int = 3;

fun[exp] nfc(text: str): str = {
    return .str_normalize(text, FORM_NFC);
};

fun[exp] nfd(text: str): str = {
    return .str_normalize(text, FORM_NFD);
};

fun[exp] nfkc(text: str): str = {
    return .str_normalize(text, FORM_NFKC);
};

fun[exp] nfkd(text: str): str = {
    return .str_normalize(text, FORM_NFKD);
};

fun[exp] is_nfc(text: str): bol = {
    return .str_is_normalized(text, FORM_NFC);
};

// Equality that ignores how the text happened to be typed. This is what a
// comparison against user input should use; `==` compares byte sequences.
fun[exp] same_text(left: str, right: str): bol = {
    return nfc(left) == nfc(right);
};

// Looser still: folds case and compatibility variants too, for search keys and
// duplicate detection. Lossy by design.
fun[exp] search_key(text: str): str = {
    return .str_lower(nfkc(text));
};
