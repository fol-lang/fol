// Growable sets, represented as a SORTED vector with no duplicates.
//
// The builtin `set[...]` is the tuple-member form — one element per declared
// member type, so `set[int]` holds exactly one value. That is a different thing
// from a growable set, and rather than add a second builtin container type
// (which would touch the parser, typecheck, the backend and the grammar), the
// growable form is built here out of `vec` plus ordering.
//
// Keeping the representation sorted is what makes membership a halving search
// and union/intersection a single merge pass.
//
// `from_vec` is the only routine that establishes that invariant. Every other
// one assumes it, so build sets with it rather than passing a raw vector.

use vecs: loc = {"../vecs"};

fun[exp] from_vec(T: ord + clone)(values: vec[T]): vec[T] = {
    return vecs::dedup_sorted(vecs::sort(values));
};

fun[exp] contains(T: ord + clone)(members: vec[T], value: T): bol = {
    return vecs::binary_search(members, [cln]value) >= 0;
};

// Inserting an element already present returns the set unchanged, so calling
// this twice is the same as calling it once.
fun[exp] insert(T: ord + clone)(members: vec[T], value: T): vec[T] = {
    if (contains(members, [cln]value)) {
        return members;
    } else {
    };
    var[mut] out: vec[T] = [mov]members;
    out.push([cln]value);
    return vecs::sort([mov]out);
};

fun[exp] remove(T: ord + clone)(members: vec[T], value: T): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(members)) {
        if (members[i] == value) {
        } else {
            out.push([cln]members[i]);
        };
        i = i + 1;
    };
    return out;
};

fun[exp] union(T: ord + clone)(left: vec[T], right: vec[T]): vec[T] = {
    return from_vec(vecs::concat(left, right));
};

fun[exp] intersect(T: ord + clone)(left: vec[T], right: vec[T]): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(left)) {
        if (contains(right, [cln]left[i])) {
            out.push([cln]left[i]);
        } else {
        };
        i = i + 1;
    };
    return out;
};

fun[exp] difference(T: ord + clone)(left: vec[T], right: vec[T]): vec[T] = {
    var[mut] out: vec[T] = {};
    var[mut] i: int = 0;
    loop (i < .len(left)) {
        if (contains(right, [cln]left[i])) {
        } else {
            out.push([cln]left[i]);
        };
        i = i + 1;
    };
    return out;
};

fun[exp] is_subset(T: ord + clone)(inner: vec[T], outer: vec[T]): bol = {
    var[mut] i: int = 0;
    loop (i < .len(inner)) {
        if (contains(outer, [cln]inner[i])) {
        } else {
            return false;
        };
        i = i + 1;
    };
    return true;
};
