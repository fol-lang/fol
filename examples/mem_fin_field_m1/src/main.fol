// A `fin` value held in a record field is finalized through its owner (V3_MEM
// §6.1): at scope exit the holder walks the field path and runs the finalizer,
// so containment does not swallow the cleanup. Ownership still decides who
// finalizes -- moving the holder hands the duty to the receiving routine, which
// releases the fields in reverse order (§6.2).

use std: pkg = {"std"};

typ File()(fin): rec = { descriptor: int };

pro (File)finalize(): non = {
    var shown: int = std::io::echo_int(self.descriptor);
    return;
};

typ Pair: rec = { left: File, right: File, tag: int };

pro[] consume(taken: Pair): non = {
    var shown: int = std::io::echo_int(taken.tag);
    return;
};

fun[] main(): int = {
    var pair: Pair = { left = { descriptor = 1 }, right = { descriptor = 2 }, tag = 9 };
    consume([mov]pair);
    var held: Pair = { left = { descriptor = 3 }, right = { descriptor = 4 }, tag = 8 };
    var shown: int = std::io::echo_int(held.tag);
    return 0;
};
