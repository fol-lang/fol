// A handle duplicated, so the resource would be released twice.
//
// Cloning would produce a second value carrying the same address, and each
// would owe a release. A linear type claims neither 'copy' nor 'clone', so
// the duplication is refused at the operation rather than at the second free.
use std: pkg = {"std"};
use wid: pkg = {"widget"};

fun[] main(): int = {
    var w: wid::Widget = wid::widget_new(21);
    var other: wid::Widget = [cln]w;
    wid::widget_free([mov]w);
    wid::widget_free([mov]other);
    return std::io::echo_int(0);
};
