pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "v4_c_roundtrip_fol", version = "0.1.0", kind = "exe",
        description = "FOL imports an installed FOL library through the C ABI",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var app = graph.add_exe({
        name = "v4_c_roundtrip_fol", root = "src/main.fol",
        fol_model = "memo", target = target, optimize = optimize,
    });
    var header = graph.file_from_root("native/v4_c_export_scalar.h");
    var provider = graph.file_from_root("native/libv4_c_export_scalar.a");
    var overlay = graph.file_from_root("interop/folslice.toml");
    app.add_c_import({
        alias = "folslice",
        header = header,
        provider = provider,
        provider_kind = "static",
        annotations = overlay,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
