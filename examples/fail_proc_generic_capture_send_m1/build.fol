pro[] build(): non = {
    var build = .build();
    build.meta({ name = "fail_proc_generic_capture_send_m1", version = "0.1.0" });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({ name = "fail-proc-generic-capture-send-m1", root = "src/main.fol", fol_model = "memo" });
    graph.install(app);
    return;
};
