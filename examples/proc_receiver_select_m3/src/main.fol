use std: pkg = {"std"};

// A `select` arm may wait on a first-class `chn[rx, T]` endpoint value, not
// only on a full channel: an arm needs the receive side, and a moved endpoint
// still carries it (V3_MEM §8.2, V3_PROC select).
fun[] main(): int = {
    var channel: chn[int];
    var sent: err[int] = 42 | channel[tx];
    var inbox: chn[rx, int] = channel[rx];
    var[mut] selected: int = 0;
    select {
        when inbox as value {
            selected = value;
        }
        * {
            selected = 7;
        }
    };
    return std::io::echo_int(selected);
};
