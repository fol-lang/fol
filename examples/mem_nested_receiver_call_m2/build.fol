pro[] build(): non = {
    var build = .build();
    build.meta({ name = "mem_nested_receiver_call_m2", version = "0.1.0" });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({ name = "mem-nested-receiver-call-m2", root = "src/main.fol", fol_model = "memo" });
    graph.install(app);
    return;
};
