// FOL calling a checked C provider through an ordinary namespace import.
//
// There is no `extern` declaration anywhere in this package. `c_math` is a
// namespace the compiler synthesized from the checked manifest that
// `fol tool bind c` wrote, so the calls below go through normal name
// resolution exactly like calls into any other package.
use std: pkg = {"std"};
use math: pkg = {"c_math"};

// `add_one` is annotated infallible, so it returns its value directly.
fun[] describe_add_one(value: int[32]): str = {
    // The C `int` is measured as 32 bits on this target, so the comparison
    // operand is bound at that width rather than at FOL's default `int`.
    var expected: int[32] = 42;
    var actual: int[32] = math::add_one(value);
    when(.eq(actual, expected)) {
        case(true) { return "add_one(41) = 42"; }
        * { return "add_one(41) WRONG"; }
    }
};

// `checked_div` is annotated with a status mapping, so FOL sees it on the
// recoverable channel: the provider's out-parameter is the success value and
// its status code is the failure. The out value cannot be read without
// handling the failure first, which is the whole point of the mapping.
// The fallback is what a caller sees when the provider reports failure; it is
// reachable only through the failure channel, so a caller cannot accidentally
// read the out value the provider never wrote.
fun[] quotient_or(lhs: int[32], rhs: int[32], fallback: int[32]): int[32] = {
    return math::checked_div(lhs, rhs) || fallback;
};

fun[] describe_div(lhs: int[32], rhs: int[32]): str = {
    var sentinel: int[32] = 99;
    var quotient: int[32] = quotient_or(lhs, rhs, sentinel);
    var six: int[32] = 6;
    when(.eq(quotient, six)) {
        case(true) { return "checked_div(42, 7) = 6"; }
        * { return "checked_div(42, 7) WRONG"; }
    }
};

// Dividing by zero makes the provider return status 1, which the annotation
// maps to the failure channel -- so the fallback is what comes back.
fun[] describe_div_by_zero(lhs: int[32]): str = {
    var zero: int[32] = 0;
    var sentinel: int[32] = 99;
    var quotient: int[32] = quotient_or(lhs, zero, sentinel);
    when(.eq(quotient, sentinel)) {
        case(true) { return "checked_div(42, 0) reported failure"; }
        * { return "checked_div(42, 0) DID NOT REPORT"; }
    }
};

fun[] main(): non = {
    std::io::echo_str(describe_add_one(41));
    var lhs: int[32] = 42;
    var rhs: int[32] = 7;
    std::io::echo_str(describe_div(lhs, rhs));
    std::io::echo_str(describe_div_by_zero(lhs));
    return;
};
