// Generic capability bounds are verified recursively (V3_MEM §4.1): `T: send`
// requires the actual type to be transitively thread-safe. `Outer` holds an
// `Rc`-backed `ptr[shared, int]` (not `Send`) nested inside `Inner`, so passing
// it to a `T: send` parameter is rejected even though the pointer is two levels
// down.

typ Inner: rec = {
    handle: ptr[shared, int],
};

typ Outer: rec = {
    inner: Inner,
};

fun cross(T: send)(item: T): int = {
    return 0;
};

fun[] main(): int = {
    var value: int = 1;
    var inner: Inner = { handle = [ref]value };
    var outer: Outer = { inner = [mov]inner };
    return cross([mov]outer);
};
