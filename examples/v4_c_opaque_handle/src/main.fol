// A C resource FOL owns, releases exactly once, and cannot look inside.
//
// `struct widget` is declared but never defined in the header, so C's own type
// system says only "an address". Which routine creates one, which may borrow
// it, and which releases it are facts C cannot state, so they come from the
// annotation overlay in `interop/widget.toml`:
//
//     [handle.Widget]
//     destroy = "widget_free"
//
//     [routine.widget_new]     handle_role = "produces"
//     [routine.widget_size]    handle_role = "borrows"
//     [routine.widget_free]    handle_role = "consumes"
//
// From that, `wid::Widget` is a FOL type claiming `lin`. The compiler then
// proves what C could not: the handle is released on every path, exactly once,
// and never read afterwards. The matching `fail_v4_c_handle_*` packages show
// each of those refusals.
//
// The domain is the identity. A handle from another provider would be a
// different FOL type, so it cannot reach this destroy at all -- no runtime tag
// is involved, because the check is the type.

use std: pkg = {"std"};
use wid: pkg = {"widget"};

fun[] main(): int = {
    var w: wid::Widget = wid::widget_new(21);

    // Borrowed for the duration of the call. The loan carries no obligation:
    // `w` still owes the release afterwards.
    var size: int[32] = wid::widget_size([bor]w);

    // The release. `[mov]` is what transfers the handle out, and after it `w`
    // cannot be borrowed, released again, or read.
    wid::widget_free([mov]w);

    var marker: int = 0;
    when(size) {
        // 21 doubled: the address really crossed to C, and C really read
        // through it.
        is(42) { marker = 7; }
        * { marker = 1; }
    };
    var reported: int = std::io::echo_int(marker);
    return 0;
};
