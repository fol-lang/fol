pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "v4_c_string_arg", version = "0.1.0",
        description = "FOL text reaching C as a NUL-terminated string",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({
        name = "v4_c_string_arg", root = "src/main.fol", fol_model = "memo",
    });
    var header = graph.file_from_root("native/text.h");
    var provider = graph.file_from_root("native/libtext.a");
    var overlay = graph.file_from_root("interop/text.toml");
    app.add_c_import({
        alias = "text",
        header = header,
        provider = provider,
        provider_kind = "static",
        annotations = overlay,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
