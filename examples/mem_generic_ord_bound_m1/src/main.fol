// A generic parameter used as a `set` member or `map` key must promise `ord`
// (V3_MEM 4.1). The bound lets the body build the container, it is re-checked
// against the actual type at every call site, and it is emitted into the Rust
// signature so a routine that stays generic still compiles. Several bounds are
// joined with `+`; a comma would start a second generic parameter.

use std: pkg = {"std"};

// The set stays empty on purpose: reading members back would tie `T` to the
// argument and let the routine be specialized away, and the case that needs the
// bound carried into Rust is the one that stays generic.
fun[] holds(T: ord)(probe: T): int = {
    var seen: set[T] = {};
    return 0;
};

fun[] main(): int = {
    std::io::echo_int(holds(7));
    return 0;
};
