pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "v4_c_callback_no_context", version = "0.1.0",
        description = "a provider that calls back with no context at all",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({
        name = "v4_c_callback_no_context", root = "src/main.fol", fol_model = "memo",
    });
    var header = graph.file_from_root("native/fold.h");
    var provider = graph.file_from_root("native/libfold.a");
    var overlay = graph.file_from_root("interop/fold.toml");
    app.add_c_import({
        alias = "fold",
        header = header,
        provider = provider,
        provider_kind = "static",
        annotations = overlay,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
