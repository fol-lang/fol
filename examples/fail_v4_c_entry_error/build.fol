pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "fail_v4_c_entry_error", version = "0.1.0", kind = "lib",
        description = "an entry cannot cross the C boundary without explicit tags",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var lib = graph.add_static_lib({
        name = "fail_v4_c_entry_error", root = "src/lib.fol",
        fol_model = "memo", target = target, optimize = optimize,
    });
    lib.set_abi_version({ major = 1, minor = 0 });
    lib.add_abi_export({ routine = "classify", symbol = "fol_ent_classify" });
    graph.install(lib);
    return;
};
