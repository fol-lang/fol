// Known-answer checks for std routines that nothing else calls.
//
// Roughly half of std's exported routines appear nowhere but their own
// declaration: they are typechecked, never run. These pin the ones whose
// answers are fixed by an external standard, so a regression is caught by the
// published vector rather than by whatever the code happens to produce.
//
// Exit code is the failure count, so a green run returns 0.

use std: pkg = {"std"};

fun[] want(name: str, actual: str, expected: str): int = {
    when(.eq(actual, expected)) {
        case(true) { return 0; }
        * {
            std::io::echo_str("FAIL " + name + ": got '" + actual + "' want '" + expected + "'");
            return 1;
        }
    }
};

fun[] want_int(name: str, actual: int, expected: int): int = {
    return want(name, std::fmt::int_to_str(actual), std::fmt::int_to_str(expected));
};

// RFC 4648 section 10.
fun[] base64_vectors(): int = {
    var[mut] bad: int = 0;
    bad = bad + want("b64 ''", std::codec::base64_encode(""), "");
    bad = bad + want("b64 f", std::codec::base64_encode("f"), "Zg==");
    bad = bad + want("b64 fo", std::codec::base64_encode("fo"), "Zm8=");
    bad = bad + want("b64 foo", std::codec::base64_encode("foo"), "Zm9v");
    bad = bad + want("b64 foob", std::codec::base64_encode("foob"), "Zm9vYg==");
    bad = bad + want("b64 fooba", std::codec::base64_encode("fooba"), "Zm9vYmE=");
    bad = bad + want("b64 foobar", std::codec::base64_encode("foobar"), "Zm9vYmFy");
    bad = bad + want("b64 decode", std::codec::base64_decode("Zm9v"), "foo");
    bad = bad + want("b64 round trip",
        std::codec::base64_decode(std::codec::base64_encode("foobar")), "foobar");
    return bad;
};

// The CRC-32 check value, and the FNV-1a 32-bit reference offsets.
fun[] digest_vectors(): int = {
    var[mut] bad: int = 0;
    bad = bad + want("crc32 check", std::codec::crc32_hex("123456789"), "cbf43926");
    bad = bad + want_int("fnv1a ''", std::hash::fnv1a(""), 2166136261);
    bad = bad + want_int("fnv1a a", std::hash::fnv1a("a"), 3826002220);
    bad = bad + want_int("fnv1a foobar", std::hash::fnv1a("foobar"), 3214735720);
    return bad;
};

// The cases a path splitter usually gets wrong: several dots, no dot, a dot in
// a directory rather than the file, and an absolute right-hand join.
fun[] path_edges(): int = {
    var[mut] bad: int = 0;
    bad = bad + want("ext tar.gz", std::path::extension("archive.tar.gz"), "gz");
    bad = bad + want("ext none", std::path::extension("noext"), "");
    bad = bad + want("ext dot dir", std::path::extension("dir.d/file"), "");
    bad = bad + want("ext trailing dot", std::path::extension("file."), "");
    // A leading dot names a hidden file; it is not an extension separator.
    bad = bad + want("ext hidden", std::path::extension(".hidden"), "");
    bad = bad + want("stem hidden", std::path::file_stem(".hidden"), ".hidden");
    bad = bad + want("stem tar.gz", std::path::file_stem("archive.tar.gz"), "archive.tar");
    bad = bad + want("stem none", std::path::file_stem("noext"), "noext");
    bad = bad + want("file_name", std::path::file_name("/a/b/c.txt"), "c.txt");
    bad = bad + want("parent", std::path::parent("/a/b/c.txt"), "/a/b");
    bad = bad + want("normalize ..", std::path::normalize("a/b/../c"), "a/c");
    bad = bad + want("normalize .", std::path::normalize("a/./b"), "a/b");
    bad = bad + want("join", std::path::join("a", "b"), "a/b");
    bad = bad + want("join absolute right", std::path::join("a", "/b"), "/b");
    return bad;
};

// A delimiter inside a quoted field, and a doubled quote meaning one literal
// quote -- the two cases that separate a CSV reader from a `split`.
fun[] csv_quoting(): int = {
    var[mut] bad: int = 0;
    var commas: vec[str] = std::csv::parse_row("a,\"b,c\",d");
    bad = bad + want_int("quoted comma count", .len(commas), 3);
    bad = bad + want("quoted comma field", commas[1], "b,c");

    var quoted: vec[str] = std::csv::parse_row("a,\"he said \"\"hi\"\"\",z");
    bad = bad + want_int("escaped quote count", .len(quoted), 3);
    bad = bad + want("escaped quote field", quoted[1], "he said \"hi\"");

    bad = bad + want("encode plain", std::csv::encode_field("plain"), "plain");
    bad = bad + want("encode comma", std::csv::encode_field("a,b"), "\"a,b\"");
    bad = bad + want("encode quote", std::csv::encode_field("a\"b"), "\"a\"\"b\"");
    bad = bad + want_int("column_count", std::csv::column_count("a,\"b,c\",d"), 3);

    var fields: vec[str] = { "plain", "a,b", "he said \"hi\"" };
    var back: vec[str] = std::csv::parse_row(std::csv::encode_row(fields));
    bad = bad + want_int("round trip count", .len(back), 3);
    bad = bad + want("round trip 0", back[0], "plain");
    bad = bad + want("round trip 1", back[1], "a,b");
    bad = bad + want("round trip 2", back[2], "he said \"hi\"");
    return bad;
};

// Helpers for the container checks below.
fun[] show(values: vec[int]): str = {
    var[mut] out: str = "";
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        out = out + std::fmt::int_to_str(values[i]);
        when(i + 1 < .len(values)) { case(true) { out = out + ","; } * { } }
        i = i + 1;
    };
    return out;
};

fun[] is_big(value: int): bol = { return value > 3; };
fun[] doubled(value: int): int = { return value * 2; };

// A heap must drain in order, and the stack/queue shapes must agree with the
// module header: the stack top is the END of the vector, the queue front is 0.
fun[] ordering_invariants(): int = {
    var[mut] bad: int = 0;
    var[mut] h: vec[int] = {};
    var seeds: vec[int] = { 5, 3, 9, 1, 7, 3, 8, 2 };
    var[mut] i: int = 0;
    loop (i < .len(seeds)) {
        h = std::heap::heap_push(h, seeds[i]);
        i = i + 1;
    };
    bad = bad + want_int("heap size", .len(h), 8);
    bad = bad + want_int("heap peek is min", std::heap::heap_peek(h, -1), 1);
    bad = bad + want("heap drains sorted", show(std::heap::heap_drain(h)), "1,2,3,3,5,7,8,9");

    var[mut] q: vec[int] = {};
    q = std::heap::queue_push(q, 1);
    q = std::heap::queue_push(q, 2);
    bad = bad + want_int("queue front", std::heap::queue_front(q, -1), 1);
    bad = bad + want("queue after pop", show(std::heap::queue_pop(q)), "2");
    var pair: vec[int] = { 1, 2 };
    bad = bad + want("stack pushes on the end", show(std::heap::stack_push(pair, 9)), "1,2,9");
    return bad;
};

// Set algebra over sorted-unique vectors.
fun[] set_algebra(): int = {
    var[mut] bad: int = 0;
    var a: vec[int] = { 1, 2, 3, 4 };
    var b: vec[int] = { 3, 4, 5 };
    var small: vec[int] = { 3, 4 };
    var none: vec[int] = {};
    bad = bad + want("union", show(std::sets::union(a, b)), "1,2,3,4,5");
    bad = bad + want("intersect", show(std::sets::intersect(a, b)), "3,4");
    bad = bad + want("difference", show(std::sets::difference(a, b)), "1,2");
    bad = bad + want("difference reversed", show(std::sets::difference(b, a)), "5");
    bad = bad + want("subset yes", std::fmt::bol_to_str(std::sets::is_subset(small, a)), "true");
    bad = bad + want("subset no", std::fmt::bol_to_str(std::sets::is_subset(b, a)), "false");
    bad = bad + want("empty is a subset", std::fmt::bol_to_str(std::sets::is_subset(none, a)), "true");
    return bad;
};

// Sequence helpers, including the empty and past-the-end cases.
fun[] sequence_edges(): int = {
    var[mut] bad: int = 0;
    var a: vec[int] = { 1, 2, 3, 4, 5 };
    var b: vec[int] = { 10, 20, 30, 40, 50 };
    var empty: vec[int] = {};
    var unsorted: vec[int] = { 3, 1 };
    bad = bad + want("range_int", show(std::vecs::range_int(2, 5)), "2,3,4");
    bad = bad + want("range_int empty", show(std::vecs::range_int(5, 5)), "");
    bad = bad + want("is_sorted yes", std::fmt::bol_to_str(std::vecs::is_sorted(a)), "true");
    bad = bad + want("is_sorted no", std::fmt::bol_to_str(std::vecs::is_sorted(unsorted)), "false");
    bad = bad + want_int("min_of", std::vecs::min_of(a, 0), 1);
    bad = bad + want_int("max_of", std::vecs::max_of(a, 0), 5);
    bad = bad + want_int("min_of empty falls back", std::vecs::min_of(empty, 42), 42);
    bad = bad + want("skip", show(std::iter::skip(a, 2)), "3,4,5");
    bad = bad + want("skip past the end", show(std::iter::skip(a, 99)), "");
    bad = bad + want_int("count_if", std::iter::count_if(a, is_big), 2);
    bad = bad + want("any yes", std::fmt::bol_to_str(std::iter::any(a, is_big)), "true");
    bad = bad + want("any over empty", std::fmt::bol_to_str(std::iter::any(empty, is_big)), "false");
    bad = bad + want("map_to", show(std::iter::map_to(a, doubled)), "2,4,6,8,10");
    bad = bad + want("take_while stops at once", show(std::iter::take_while(a, is_big)), "");
    bad = bad + want("skip_while skips none", show(std::iter::skip_while(a, is_big)), "1,2,3,4,5");
    bad = bad + want("zip_add_int", show(std::iter::zip_add_int(a, b)), "11,22,33,44,55");
    return bad;
};

// A 3x2 board laid out row major. `neighbours` is the eight surrounding cells,
// with the missing ones reading as the fallback.
fun[] grid_addressing(): int = {
    var[mut] bad: int = 0;
    var cells: vec[int] = { 1, 2, 3, 4, 5, 6 };
    bad = bad + want("in_bounds yes", std::fmt::bol_to_str(std::grid::in_bounds(3, 2, 1, 2)), "true");
    bad = bad + want("in_bounds row past end", std::fmt::bol_to_str(std::grid::in_bounds(3, 2, 2, 0)), "false");
    bad = bad + want("in_bounds negative", std::fmt::bol_to_str(std::grid::in_bounds(3, 2, 0, 0 - 1)), "false");
    bad = bad + want("column_of", show(std::grid::column_of(cells, 3, 2, 1, 0)), "2,5");
    bad = bad + want("neighbours fill the corners", show(std::grid::neighbours(cells, 3, 0, 1, 0)), "0,0,0,1,3,4,5,6");
    return bad;
};

fun[] main(): int = {
    var[mut] bad: int = 0;
    bad = bad + base64_vectors();
    bad = bad + digest_vectors();
    bad = bad + path_edges();
    bad = bad + csv_quoting();
    bad = bad + ordering_invariants();
    bad = bad + set_algebra();
    bad = bad + sequence_edges();
    bad = bad + grid_addressing();
    bad = bad + numeric_edges();
    bad = bad + text_edges();
    bad = bad + map_and_json();
    bad = bad + random_invariants();
    bad = bad + file_surface();
    bad = bad + process_and_clock();
    bad = bad + json_is_robust();
    return bad;
};

// Boundaries and negatives, where an off-by-one or a sign slip would live.
fun[] numeric_edges(): int = {
    var[mut] bad: int = 0;
    bad = bad + want_int("clamp below", std::nums::clamp_int(1, 3, 7), 3);
    bad = bad + want_int("clamp above", std::nums::clamp_int(9, 3, 7), 7);
    bad = bad + want_int("clamp at the low edge", std::nums::clamp_int(3, 3, 7), 3);
    bad = bad + want_int("sign negative", std::nums::sign_int(0 - 9), 0 - 1);
    bad = bad + want_int("sign zero", std::nums::sign_int(0), 0);
    bad = bad + want("even zero", std::fmt::bol_to_str(std::nums::is_even(0)), "true");
    bad = bad + want("odd negative", std::fmt::bol_to_str(std::nums::is_odd(0 - 3)), "true");
    bad = bad + want_int("lcm", std::nums::lcm(4, 6), 12);
    bad = bad + want_int("lcm with zero", std::nums::lcm(0, 5), 0);
    bad = bad + want_int("pow_int", std::nums::pow_int(2, 10), 1024);
    bad = bad + want_int("pow_int zero exponent", std::nums::pow_int(7, 0), 1);
    bad = bad + want("to_hex", std::fmt::to_hex(255), "ff");
    bad = bad + want("to_hex zero", std::fmt::to_hex(0), "0");
    bad = bad + want("to_bin", std::fmt::to_bin(10), "1010");
    bad = bad + want("to_oct", std::fmt::to_oct(8), "10");
    bad = bad + want("thousands", std::fmt::with_thousands(1234567, ","), "1,234,567");
    bad = bad + want("thousands below a group", std::fmt::with_thousands(12, ","), "12");
    bad = bad + want("thousands on the boundary", std::fmt::with_thousands(1000, ","), "1,000");
    bad = bad + want_int("char code", std::chars::code('A'), 65);
    bad = bad + want_int("char round trip", std::chars::code(std::chars::from_code(90)), 90);
    bad = bad + want("is_lower on a digit", std::fmt::bol_to_str(std::chars::is_lower('7')), "false");
    bad = bad + want("hex digit letter", std::fmt::bol_to_str(std::chars::is_hex_digit('f')), "true");
    bad = bad + want("hex digit rejected", std::fmt::bol_to_str(std::chars::is_hex_digit('g')), "false");
    bad = bad + want("hex_encode", std::codec::hex_encode("AB"), "4142");
    bad = bad + want("hex round trip", std::codec::hex_decode(std::codec::hex_encode("foobar")), "foobar");
    return bad;
};

// Text: empties, misses, and the difference between canonical equivalence and
// case folding -- `same_text` normalises, `search_key` also folds.
fun[] text_edges(): int = {
    var[mut] bad: int = 0;
    bad = bad + want("is_empty yes", std::fmt::bol_to_str(std::strn::is_empty("")), "true");
    bad = bad + want("is_empty no", std::fmt::bol_to_str(std::strn::is_empty(" ")), "false");
    bad = bad + want("trim_start", std::strn::trim_start("   x  "), "x  ");
    bad = bad + want("trim_start all space", std::strn::trim_start("   "), "");
    bad = bad + want("to_upper", std::strn::to_upper("aBc"), "ABC");
    bad = bad + want("strip_prefix hit", std::strn::strip_prefix("foobar", "foo"), "bar");
    bad = bad + want("strip_prefix miss", std::strn::strip_prefix("foobar", "xyz"), "foobar");
    bad = bad + want("strip_prefix whole", std::strn::strip_prefix("foo", "foo"), "");
    bad = bad + want_int("count_matches", std::strn::count_matches("abcabc", "abc"), 2);
    bad = bad + want_int("count_matches none", std::strn::count_matches("abc", "zz"), 0);
    bad = bad + want_int("count_matches does not overlap", std::strn::count_matches("aaa", "aa"), 1);
    bad = bad + want("is_space_byte", std::fmt::bol_to_str(std::strn::is_space_byte(32)), "true");
    bad = bad + want("is_space_byte no", std::fmt::bol_to_str(std::strn::is_space_byte(65)), "false");

    var precomposed: str = "é";
    var decomposed: str = std::strn::nfd(precomposed);
    bad = bad + want("nfc input is nfc", std::fmt::bol_to_str(std::strn::is_nfc(precomposed)), "true");
    bad = bad + want("nfd is not nfc", std::fmt::bol_to_str(std::strn::is_nfc(decomposed)), "false");
    bad = bad + want_int("nfd is longer", .len(decomposed), 3);
    bad = bad + want("nfd of ascii is itself", std::strn::nfd("abc"), "abc");
    bad = bad + want("same_text spans normalisation",
        std::fmt::bol_to_str(std::strn::same_text(precomposed, decomposed)), "true");
    bad = bad + want("same_text keeps case apart",
        std::fmt::bol_to_str(std::strn::same_text("AbC", "aBc")), "false");
    bad = bad + want("search_key folds case",
        std::fmt::bol_to_str(.eq(std::strn::search_key("AbC"), std::strn::search_key("abc"))), "true");

    var nums: vec[int] = { 1, 2, 3 };
    var back: vec[int] = std::vecs::reverse(nums);
    bad = bad + want_int("reverse first", back[0], 3);
    bad = bad + want_int("reverse last", back[2], 1);
    bad = bad + want("with_extension", std::path::with_extension("a/b.txt", "md"), "a/b.md");
    bad = bad + want("with_extension when absent", std::path::with_extension("a/b", "md"), "a/b.md");
    return bad;
};

fun[] show_str(values: vec[str]): str = {
    var[mut] out: str = "";
    var[mut] i: int = 0;
    loop (i < .len(values)) {
        out = out + values[i];
        when(i + 1 < .len(values)) { case(true) { out = out + ","; } * { } }
        i = i + 1;
    };
    return out;
};

// Maps keep key order, and the flat JSON codec survives a value that needs
// escaping and one that is empty.
fun[] map_and_json(): int = {
    var[mut] bad: int = 0;
    var[mut] ages: map[str, int] = {};
    ages.insert("ada", 36);
    ages.insert("bob", 41);
    ages.insert("cy", 7);
    bad = bad + want("has_key yes", std::fmt::bol_to_str(std::maps::has_key(ages, "ada")), "true");
    bad = bad + want("has_key no", std::fmt::bol_to_str(std::maps::has_key(ages, "zz")), "false");
    bad = bad + want_int("sum_values", std::maps::sum_values(ages), 84);
    var first: std::maps::Pair[str, int] = std::maps::pairs(ages)[0];
    bad = bad + want("pairs are key ordered", first.key, "ada");
    bad = bad + want_int("a pair carries its value", first.value, 36);
    bad = bad + want_int("values_of count", .len(std::maps::values_of(ages)), 3);
    bad = bad + want("keys_where takes a floor", show_str(std::maps::keys_where(ages, 36)), "ada,bob");
    var flipped: map[int, str] = std::maps::invert(ages);
    bad = bad + want("invert finds the old value", std::fmt::bol_to_str(std::maps::has_key(flipped, 41)), "true");
    bad = bad + want_int("invert keeps the size", .len(flipped), 3);

    var[mut] flat: map[str, str] = {};
    flat.insert("name", "ada");
    flat.insert("quote", "he said \"hi\"");
    flat.insert("empty", "");
    var decoded: map[str, str] = std::json::decode_flat(std::json::encode_flat(flat));
    bad = bad + want_int("flat round trip size", .len(decoded), 3);
    var quoted: opt[str] = decoded.get("quote");
    when(quoted) {
        on(v) { bad = bad + want("flat round trip escapes", v, "he said \"hi\""); }
        * { bad = bad + want("flat round trip escapes", "missing", "present"); }
    }
    var blank: opt[str] = decoded.get("empty");
    when(blank) {
        on(v) { bad = bad + want("flat round trip empty value", v, ""); }
        * { bad = bad + want("flat round trip empty value", "missing", "present"); }
    }
    return bad;
};

// A pure generator: reproducible from a seed, half-open in range, and a shuffle
// that is a permutation rather than a resample.
fun[] random_invariants(): int = {
    var[mut] bad: int = 0;
    var a: std::rand::Draw = std::rand::next(std::rand::seeded(12345));
    var b: std::rand::Draw = std::rand::next(std::rand::seeded(12345));
    bad = bad + want("a seed is reproducible", std::fmt::bol_to_str(.eq(a.value, b.value)), "true");
    var zero: std::rand::Draw = std::rand::next(std::rand::seeded(0));
    var zero_next: std::rand::Draw = std::rand::next(zero.rng);
    bad = bad + want("a zero seed still moves", std::fmt::bol_to_str(.nq(zero.value, zero_next.value)), "true");

    var[mut] rng: std::rand::Rng = std::rand::seeded(99);
    var[mut] i: int = 0;
    var[mut] outside: int = 0;
    var[mut] saw_low: bol = false;
    var[mut] saw_top: bol = false;
    loop (i < 400) {
        var d: std::rand::Draw = std::rand::next_range(rng, 3, 7);
        rng = d.rng;
        when((d.value < 3) or (d.value >= 7)) { case(true) { outside = outside + 1; } * { } }
        when(.eq(d.value, 3)) { case(true) { saw_low = true; } * { } }
        when(.eq(d.value, 6)) { case(true) { saw_top = true; } * { } }
        i = i + 1;
    };
    bad = bad + want_int("next_range is half open", outside, 0);
    bad = bad + want("next_range reaches its low end", std::fmt::bol_to_str(saw_low), "true");
    bad = bad + want("next_range reaches high minus one", std::fmt::bol_to_str(saw_top), "true");

    var[mut] trues: int = 0;
    var[mut] j: int = 0;
    loop (j < 200) {
        var d: std::rand::Draw = std::rand::next_bool(rng);
        rng = d.rng;
        when(.nq(d.value, 0)) { case(true) { trues = trues + 1; } * { } }
        j = j + 1;
    };
    bad = bad + want("next_bool yields both", std::fmt::bol_to_str((trues > 0) and (trues < 200)), "true");

    var source: vec[int] = { 1, 2, 3, 4, 5, 6, 7, 8 };
    var shuffled: std::rand::DrawVec = std::rand::shuffle_int(rng, source);
    bad = bad + want_int("shuffle keeps the length", .len(shuffled.values), 8);
    var[mut] total: int = 0;
    var[mut] k: int = 0;
    loop (k < .len(shuffled.values)) {
        total = total + shuffled.values[k];
        k = k + 1;
    };
    bad = bad + want_int("shuffle keeps the elements", total, 36);
    var pick: std::rand::Draw = std::rand::choice_int(shuffled.rng, source, 0 - 1);
    bad = bad + want("choice comes from the vector",
        std::fmt::bol_to_str((pick.value >= 1) and (pick.value <= 8)), "true");
    var none: vec[int] = {};
    var fallback: std::rand::Draw = std::rand::choice_int(pick.rng, none, 0 - 1);
    bad = bad + want_int("choice over empty falls back", fallback.value, 0 - 1);
    return bad;
};

// The streaming file surface, against a real temp file that is removed after.
fun[] file_surface(): int = {
    var[mut] bad: int = 0;
    var path: str = std::fs::temp_path("fol_std_checks");
    bad = bad + want("temp_path is not empty", std::fmt::bol_to_str(.len(path) > 0), "true");

    var w: int = std::fs::open_write(path);
    bad = bad + want("open_write gives a handle", std::fmt::bol_to_str(w >= 0), "true");
    // write_text answers the byte count, not a status.
    bad = bad + want_int("write_text counts bytes", std::fs::write_text(w, "hello"), 5);
    bad = bad + want_int("flush succeeds", std::fs::flush(w), 0);
    bad = bad + want_int("close succeeds", std::fs::close(w), 0);
    bad = bad + want("the whole file reads back", std::fs::read_file(path), "hello");

    var a: int = std::fs::open_append(path);
    var appended: int = std::fs::write_text(a, " world");
    var closed_a: int = std::fs::close(a);
    bad = bad + want("append kept the original", std::fs::read_file(path), "hello world");

    var r: int = std::fs::open_read(path);
    var first: vec[int] = std::fs::read_chunk(r, 5);
    bad = bad + want_int("chunk length", .len(first), 5);
    bad = bad + want("chunk decodes", .str_from_bytes(first), "hello");
    var rewound: int = std::fs::rewind(r);
    bad = bad + want("rewind returns to the start", .str_from_bytes(std::fs::read_chunk(r, 5)), "hello");
    var closed_r: int = std::fs::close(r);

    // Lossless at any chunk size, including one byte at a time.
    bad = bad + want("read_streamed whole", std::fs::read_streamed(path, 3), "hello world");
    bad = bad + want("read_streamed one byte at a time", std::fs::read_streamed(path, 1), "hello world");

    bad = bad + want_int("write_atomic succeeds", std::fs::write_atomic(path, "replaced"), 0);
    bad = bad + want("write_atomic replaced", std::fs::read_file(path), "replaced");

    var u: int = std::fs::open_update(path);
    bad = bad + want_int("try_lock_exclusive succeeds", std::fs::try_lock_exclusive(u), 0);
    bad = bad + want_int("unlock succeeds", std::fs::unlock(u), 0);
    var closed_u: int = std::fs::close(u);
    var gone: int = .remove_file(path);
    return bad;
};

// A supervised child and the shared-counter surface. The clock check asserts
// only year and month, which no timezone offset can move for this instant.
fun[] process_and_clock(): int = {
    var[mut] bad: int = 0;
    var missing: str = std::fs::read_file("/nonexistent/fol/std/checks");
    bad = bad + want("not_found after a miss", std::fmt::bol_to_str(std::os::not_found()), "true");
    bad = bad + want("denied is not set", std::fmt::bol_to_str(std::os::denied()), "false");
    bad = bad + want("error_kind is set", std::fmt::bol_to_str(.nq(std::os::error_kind(), 0)), "true");
    bad = bad + want("program is named", std::fmt::bol_to_str(.len(std::os::program()) > 0), "true");

    var set_it: int = std::os::set_env("FOL_STD_CHECK", "x");
    bad = bad + want("env round trip", std::os::env("FOL_STD_CHECK"), "x");
    bad = bad + want_int("unset_env succeeds", std::os::unset_env("FOL_STD_CHECK"), 0);

    var args: vec[str] = { "-c", "exit 7" };
    var child: int = std::os::spawn("/bin/sh", args);
    bad = bad + want("spawn gives a handle", std::fmt::bol_to_str(child >= 0), "true");
    bad = bad + want("the child has a pid", std::fmt::bol_to_str(std::os::child_id(child) > 0), "true");
    var[mut] spins: int = 0;
    loop (std::os::child_running(child) and (spins < 500)) {
        var slept: int = std::time::sleep_ms(5);
        spins = spins + 1;
    };
    bad = bad + want_int("a polled child keeps its status", std::os::child_status(child), 7);
    bad = bad + want_int("await reports the same status", std::os::await_child(child), 7);
    bad = bad + want_int("await releases the handle", std::os::child_status(child), 0 - 1);

    bad = bad + want("cores is positive", std::fmt::bol_to_str(std::sync::cores() > 0), "true");
    bad = bad + want("this_thread is named", std::fmt::bol_to_str(std::sync::this_thread() >= 0), "true");
    var relaxed: int = std::sync::relax();
    var slot: std::sync::Counter = std::sync::counter(10);
    bad = bad + want_int("compare_swap answers what it found", std::sync::compare_swap(slot, 10, 20), 10);
    bad = bad + want_int("compare_swap wrote it", std::sync::read(slot), 20);
    bad = bad + want_int("a stale expectation is refused", std::sync::compare_swap(slot, 10, 99), 20);
    bad = bad + want_int("the refused swap changed nothing", std::sync::read(slot), 20);
    var capped: int = std::sync::add_saturating(slot, 100, 50);
    bad = bad + want_int("add_saturating stops at the ceiling", std::sync::read(slot), 50);

    // 1465154705 seconds since the epoch is 2016-06-05 17:25 UTC. Any offset
    // moves the day at most one, so year and month are the timezone-safe parts.
    var parts: vec[int] = std::time::local_parts(1465154705);
    bad = bad + want_int("local_parts year", parts[0], 2016);
    bad = bad + want_int("local_parts month", parts[1], 6);
    var offset: int = std::time::local_offset(1465154705);
    bad = bad + want("the offset is within a day",
        std::fmt::bol_to_str((offset > 0 - 86400) and (offset < 86400)), "true");
    return bad;
};

// Parsing hostile text must answer, never fault: a parser that panics on bad
// input is a denial of service. `parse` is lenient by contract, so this asserts
// survival and the two documented signals, not rejection.
fun[] survives(name: str, text: str): int = {
    var doc: std::jsondoc::Doc = std::jsondoc::parse(text);
    var kind: int = std::jsondoc::kind_of([bor]doc, 0);
    // Every kind is either a real one or the -1 "nothing parsed" sentinel.
    when((kind >= 0 - 1) and (kind <= 6)) {
        case(true) { return 0; }
        * {
            std::io::echo_str("FAIL " + name + " gave an unknown kind "
                + std::fmt::int_to_str(kind));
            return 1;
        }
    }
};

fun[] json_is_robust(): int = {
    var[mut] bad: int = 0;
    bad = bad + survives("empty", "");
    bad = bad + survives("open brace", "{");
    bad = bad + survives("close brace", "}");
    bad = bad + survives("open bracket", "[");
    bad = bad + survives("unterminated string", "\"abc");
    bad = bad + survives("lone backslash", "\"\\");
    bad = bad + survives("bad escape", "\"\\q\"");
    bad = bad + survives("truncated unicode", "\"\\u00\"");
    bad = bad + survives("trailing comma", "[1,2,]");
    bad = bad + survives("missing colon", "{\"a\" 1}");
    bad = bad + survives("naked comma", ",");
    bad = bad + survives("deep nesting", "[[[[[[[[[[1]]]]]]]]]]");
    bad = bad + survives("not json at all", "hello world");
    bad = bad + survives("number soup", "1.2.3e");

    // The two documented signals.
    var broken: std::jsondoc::Doc = std::jsondoc::parse("{");
    bad = bad + want_int("a broken container leaves an empty arena",
        std::jsondoc::kind_of([bor]broken, 0), 0 - 1);
    var garbage: std::jsondoc::Doc = std::jsondoc::parse("hello");
    bad = bad + want_int("NUM is a fallthrough, not a claim",
        std::jsondoc::kind_of([bor]garbage, 0), 2);
    bad = bad + want("the raw text is kept verbatim",
        std::jsondoc::text_of([bor]garbage, 0), "hello");

    var good: std::jsondoc::Doc = std::jsondoc::parse("{\"a\":1}");
    bad = bad + want_int("a real object still parses",
        std::jsondoc::kind_of([bor]good, 0), 5);
    return bad;
};
