// Build description for csv-report.
//
// Comments only appear above the routine: a `//` line between statements
// inside the `build()` body makes build evaluation fail with F1001.

pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "csv_report",
        version = "0.1.0",
        kind = "exe",
        description = "validate delimited shipment records and report on them",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var app = graph.add_exe({
        name = "csv_report",
        root = "src/main.fol",
        fol_model = "memo",
        target = target,
        optimize = optimize,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
