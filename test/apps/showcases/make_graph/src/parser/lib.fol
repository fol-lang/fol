use std: pkg = {"std"};
use reader: loc = {"../reader"};
use table: loc = {"../table"};

// input.c: turn makefile text into the name table.
//
// The original reads one line at a time from a FILE* and peeks ahead for the
// tab-indented recipe, rewinding through a two-buffer shuffle (`str1`/`str2`).
// Here the whole makefile arrives as one string and the recipe is attached to
// whichever rule line was seen last -- the same grammar, driven forwards instead
// of with a one-line lookahead. `std::fs` does stream (`open_read`/`read_chunk`,
// and `read_streamed` for the lossless whole), but a makefile is small and the
// forward-driven grammar needs no lookahead buffer at all.

pro[exp] (table::Make[mut, bor]) input(text: str): non = {
    var body: str = reader::splice(text);
    var total: int = reader::line_count(body);
    var[mut] index: int = 0;
    loop(index < total) {
        var raw: str = reader::strip_comment(reader::line_at(body, index));
        var body_line: str = reader::trim(raw);
        var is_cmd: bol = std::strn::byte_at(raw, 0) == reader::tab_code();
        when(.len(body_line) == 0) {
            case(true) { }
            * {
                when(is_cmd) {
                    case(true) { self.take_command(body_line); }
                    * { self.take_rule(raw); }
                }
            }
        };
        when(.len(self.problem) > 0) {
            case(true) { break; }
            * { }
        };
        index = index + 1;
    };
    return;
};

// newcmd, fanned out over every target sharing the rule line.
pro[exp] (table::Make[mut, bor]) take_command(line: str): non = {
    var open_rule: str = self.open_rule;
    when(.len(open_rule) == 0) {
        case(true) {
            self.complain("Rules not allowed here");
            return;
        }
        * { }
    };
    var[mut] index: int = 0;
    loop(index < reader::word_count(open_rule)) {
        var node: int = self.lookup(reader::word_at(open_rule, index));
        when(node >= 0) {
            case(true) { self.add_cmd(node, line); }
            * { }
        };
        index = index + 1;
    };
    return;
};

// A non-indented line is either a macro definition or a rule. The original
// looks for '=' before it looks for ':', so `OBJ = a:b` is a macro and not a
// rule; that ordering is kept.
pro[exp] (table::Make[mut, bor]) take_rule(raw: str): non = {
    var assign: int = std::strn::find(raw, "=");
    when(assign >= 0) {
        case(true) {
            var name: str = reader::word_at(std::strn::sub(raw, 0, assign), 0);
            var value: str = reader::trim(std::strn::sub(raw, assign + 1, .len(raw) - assign - 1));
            when(.len(name) == 0) {
                case(true) { self.complain("No macro name"); }
                * { self.set_macro(name, value); }
            };
            self.set_open("");
            return;
        }
        * { }
    };

    // A ';' splits the rule line from an inline recipe, before expansion, the
    // way the original does it.
    var semi: int = std::strn::find(raw, ";");
    var[mut] head: str = raw;
    var[mut] inline_cmd: str = "";
    when(semi >= 0) {
        case(true) {
            head = std::strn::sub(raw, 0, semi);
            inline_cmd = reader::trim(std::strn::sub(raw, semi + 1, .len(raw) - semi - 1));
        }
        * { }
    };

    var line: str = self.expand(head);
    var colon: int = std::strn::find(line, ":");
    when(colon < 0) {
        case(true) {
            self.complain("No targets provided");
            return;
        }
        * { }
    };
    when(std::strn::byte_at(line, colon + 1) == 58) {
        case(true) {
            self.complain("Double-colon rules are not supported");
            return;
        }
        * { }
    };

    var targets: str = std::strn::sub(line, 0, colon);
    var wants: str = std::strn::sub(line, colon + 1, .len(line) - colon - 1);

    var[mut] slot: int = 0;
    loop(slot < reader::word_count(targets)) {
        var target: str = reader::word_at(targets, slot);
        self.intern(target);
        var node: int = self.lookup(target);
        when(node < 0) {
            case(true) { break; }
            * { }
        };
        // "Commands defined twice for target": a second recipe for a
        // single-colon target is an error, not an append.
        when((self.cmd_count(node) > 0) and (.len(inline_cmd) > 0)) {
            case(true) { self.complain("Commands defined twice for target " + target); }
            * { }
        };
        self.mark_target(node);
        var[mut] want: int = 0;
        loop(want < reader::word_count(wants)) {
            var dep: str = reader::word_at(wants, want);
            self.intern(dep);
            self.add_dep(node, dep);
            want = want + 1;
        };
        when(.len(inline_cmd) > 0) {
            case(true) { self.add_cmd(node, inline_cmd); }
            * { }
        };
        slot = slot + 1;
    };

    self.set_open(targets);
    return;
};
