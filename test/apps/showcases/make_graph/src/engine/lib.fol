use std: pkg = {"std"};
use reader: loc = {"../reader"};
use table: loc = {"../table"};

// check.c + make.c: the cycle walk and the recursive maker.
//
// Both are recursive over the graph and both mutate the name table as they
// descend, and a `pro (T[mut, bor])` method may recurse and call other mutating
// methods on `self`, so every routine here is a receiver method on `Make` and
// the table is never moved.

// check(): descend with the N_MARK bit set, and complain if the descent
// re-enters a name that is already on the path.
pro[exp] (table::Make[mut, bor]) walk(node: int): non = {
    when(.len(self.problem) > 0) {
        case(true) { return; }
        * { }
    };
    when(self.mark[node]) {
        case(true) {
            self.complain("Circular dependency from " + self.name_of(node));
            return;
        }
        * { }
    };
    self.set_mark(node, true);
    var[mut] pos: int = 0;
    loop(pos < self.dep_count(node)) {
        var child: int = self.dep_node(node, pos);
        when(child >= 0) {
            case(true) { self.walk(child); }
            * { }
        };
        pos = pos + 1;
    };
    self.set_mark(node, false);
    return;
};

// circh(): every name is a candidate root, because a cycle need not touch the
// default goal.
pro[exp] (table::Make[mut, bor]) circles(): non = {
    var[mut] pos: int = 0;
    loop(pos < self.count) {
        self.walk(pos);
        pos = pos + 1;
    };
    return;
};

// modtime(): the bytes give the stamp, and `.file_mtime` answers N_EXISTS --
// it reports -1 for a file that is not there, which is the one thing a content
// stamp cannot distinguish from a file that is there and empty.
pro[exp] (table::Make[mut, bor]) modtime(node: int): non = {
    var path: str = self.name_of(node);
    var text: str = std::fs::read_file(path);
    self.set_stamp(node, reader::stamp(text), .file_mtime(path) >= 0);
    return;
};

// The stamp database stands in for the filesystem's mtimes: one line per
// target, holding the dependency stamps that were in force when it was built.
pro[exp] (table::Make[mut, bor]) load_db(text: str): non = {
    var[mut] pos: int = 0;
    loop(pos < reader::line_count(text)) {
        var line: str = reader::line_at(text, pos);
        var target: str = reader::word_at(line, 0);
        var node: int = self.lookup(target);
        when(node >= 0) {
            case(true) {
                var rest: str = reader::trim(std::strn::sub(line, .len(target), .len(line) - .len(target)));
                self.set_recorded(node, rest);
            }
            * { }
        };
        pos = pos + 1;
    };
    return;
};

// suffix(): everything before the last dot of the file name.
fun[exp] stem_of(name: str): str = {
    var[mut] pos: int = .len(name) - 1;
    loop(pos >= 0) {
        when(std::strn::byte_at(name, pos) == 46) {
            case(true) { return std::strn::sub(name, 0, pos); }
            * { }
        };
        pos = pos - 1;
    };
    return name;
};

// docmds1(): run one recipe, honouring the per-command '@' and '-' prefixes.
pro[exp] (table::Make[mut, bor]) docmds(node: int): non = {
    var whole: str = self.name_of(node);
    var first_dep: str = self.dep_name(node, 0);
    var changed: str = self.changed_deps(node);
    var stem: str = stem_of(whole);
    var[mut] pos: int = 0;
    loop(pos < self.cmd_count(node)) {
        var text: str = self.expand_cmd(self.cmd_at(node, pos), whole, first_dep, changed, stem);
        var[mut] line: str = text;
        var[mut] hushed: bol = self.silent;
        var[mut] forgiving: bol = false;
        loop(.len(line) > 0) {
            var head: int = std::strn::byte_at(line, 0);
            when(head == 64) {
                case(true) {
                    hushed = true;
                    line = std::strn::sub(line, 1, .len(line) - 1);
                }
                * {
                    when(head == 45) {
                        case(true) {
                            forgiving = true;
                            line = std::strn::sub(line, 1, .len(line) - 1);
                        }
                        * { break; }
                    }
                }
            }
        };
        // A dry run echoes even the silenced commands, as the original does.
        when(hushed and self.domake) {
            case(true) { }
            * { self.say(line); }
        };
        when(self.domake) {
            case(true) {
                var status: int = std::os::shell(line);
                when(status != 0) {
                    case(true) {
                        when(forgiving) {
                            case(true) { self.say("make: " + line + " (Ignored)"); }
                            * {
                                self.set_failed(node);
                                self.complain("Command failed for " + whole);
                            }
                        }
                    }
                    * { }
                }
            }
            * { }
        };
        when(self.failed[node]) {
            case(true) { break; }
            * { }
        };
        pos = pos + 1;
    };
    return;
};

// make1(): run the recipe, then re-stamp. Where the original stamps the target
// with `now` so that dependents see it as newer, this re-reads the file: a
// dependent rebuilds only if the bytes it consumes actually moved.
pro[exp] (table::Make[mut, bor]) make1(node: int): non = {
    var ran: bol = self.cmd_count(node) > 0;
    self.docmds(node);
    when(self.failed[node]) {
        case(true) { return; }
        * { }
    };
    when(self.domake) {
        case(true) {
            var signature: str = self.dep_signature(node);
            self.set_recorded(node, signature);
            self.modtime(node);
        }
        * { }
    };
    when(ran) {
        case(true) { self.set_executed(node); }
        * { }
    };
    return;
};

// make(): the recursion itself. Depth-first over the dependency list, work on
// the way back up, N_DONE so a diamond's shared corner is made once.
pro[exp] (table::Make[mut, bor]) build(node: int, level: int): non = {
    when(.len(self.problem) > 0) {
        case(true) { return; }
        * { }
    };
    when(self.done[node]) {
        case(true) { return; }
        * { }
    };

    self.modtime(node);

    when(self.is_targ[node] or self.exists[node]) {
        case(true) { }
        * {
            self.complain("Don't know how to make " + self.name_of(node));
            self.set_failed(node);
            self.set_done(node);
            return;
        }
    };

    var[mut] pos: int = 0;
    loop(pos < self.dep_count(node)) {
        var child: int = self.dep_node(node, pos);
        when(child >= 0) {
            case(true) {
                self.build(child, level + 1);
                when(self.failed[child]) {
                    case(true) { self.set_failed(node); }
                    * { }
                }
            }
            * { }
        };
        pos = pos + 1;
    };

    // Post-order: a name is recorded once every name it depends on is settled,
    // so the visit order read end to end is a topological order of the DAG.
    self.visit(node);

    when(self.failed[node]) {
        case(true) {
            self.set_done(node);
            return;
        }
        * { }
    };

    when(self.is_targ[node] and self.out_of_date(node)) {
        case(true) { self.make1(node); }
        * { }
    };
    self.set_done(node);

    when(level == 0) {
        case(true) {
            when(self.executed[node] or self.failed[node]) {
                case(true) { }
                * {
                    var verdict: str = "make: '" + self.name_of(node) + "' is up to date";
                    self.say(verdict);
                }
            }
        }
        * { }
    };
    return;
};
