// The FORTH machine: data stack, return stack, flat memory, dictionary,
// inner interpreter (DOCOL/NEXT/EXIT) and outer interpreter (INTERPRET/QUIT).
//
// jonesforth keeps every one of these in registers and in one flat address
// space: %esp is the data stack, %ebp the return stack, %esi the instruction
// pointer, and the dictionary is a linked list threaded through the same bytes
// that hold compiled code. That layout is reproduced here cell for cell -- the
// only thing that moved out of memory is the input text, because FOL cannot
// point at the bytes of a `str`.

use std: pkg = {"std"};
use words: loc = {"../words"};
use text: loc = {"../text"};

typ[exp] Forth: rec = {
    var page0: vec[int];
    var page1: vec[int];
    var page2: vec[int];
    var stack: arr[int, 32];
    var depth: int;
    var rstack: arr[int, 32];
    var rdepth: int;
    var ip: int;
    var input: str;
    var cursor: int;
    var word_len: int;
    var num_value: int;
    var num_left: int;
    var lit_cfa: int;
    var halt_cfa: int;
    var out: str;
    var fault: str;
    var halted: bol;
    var eof: bol
};

// A machine with the variables seeded the way jonesforth's `.data` section
// seeds them: HERE at the start of the data segment, LATEST empty, BASE ten.
pro[exp] fresh(): Forth = {
    var[mut] data_slots: arr[int, 32];
    var[mut] return_slots: arr[int, 32];
    var[mut] machine: Forth = {
        page0 = words::blank_page(),
        page1 = words::blank_page(),
        page2 = words::blank_page(),
        stack = data_slots,
        depth = 0,
        rstack = return_slots,
        rdepth = 0,
        ip = 0,
        input = "",
        cursor = 0,
        word_len = 0,
        num_value = 0,
        num_left = 0,
        lit_cfa = 0,
        halt_cfa = 0,
        out = "",
        fault = "",
        halted = false,
        eof = false,
    };
    machine.store(words::ADDR_HERE, words::DATA_START);
    machine.store(words::ADDR_LATEST, -1);
    machine.store(words::ADDR_BASE, 10);
    return machine;
};

// The first fault wins, so the message names the cause rather than whatever
// went wrong afterwards.
pro[exp] (Forth[mut, bor]) fail(why: str): non = {
    when(self.fault == "") {
        case(true) { self.fault = why; }
        * { }
    };
    return;
};

pro[exp] (Forth[mut, bor]) emit(chunk: str): non = {
    self.out = self.out + chunk;
    return;
};

// DATA STACK -----------------------------------------------------------------
//
// jonesforth uses the machine stack and never checks it; running off the end
// there is a segmentation fault. These four report instead.

pro[exp] (Forth[mut, bor]) push(value: int): non = {
    when(self.depth >= words::STACK_CELLS) {
        case(true) { self.fail("stack overflow"); return; }
        * { }
    };
    var slot: int = self.depth;
    self.stack[slot] = value;
    self.depth = self.depth + 1;
    return;
};

pro[exp] (Forth[mut, bor]) pop(): int = {
    when(self.depth <= 0) {
        case(true) { self.fail("stack underflow"); return 0; }
        * { }
    };
    self.depth = self.depth - 1;
    var slot: int = self.depth;
    return self.stack[slot];
};

pro[exp] (Forth[mut, bor]) peek(back: int): int = {
    when(self.depth <= back) {
        case(true) { self.fail("stack underflow"); return 0; }
        * { }
    };
    var slot: int = self.depth - 1 - back;
    return self.stack[slot];
};

pro[exp] (Forth[mut, bor]) drop_top(): non = {
    when(self.depth <= 0) {
        case(true) { self.fail("stack underflow"); return; }
        * { }
    };
    self.depth = self.depth - 1;
    return;
};

pro[exp] (Forth[mut, bor]) push_flag(flag: bol): non = {
    when(flag) {
        case(true) { self.push(1); }
        * { self.push(0); }
    };
    return;
};

// RETURN STACK ---------------------------------------------------------------

pro[exp] (Forth[mut, bor]) rpush(value: int): non = {
    when(self.rdepth >= words::STACK_CELLS) {
        case(true) { self.fail("return stack overflow"); return; }
        * { }
    };
    var slot: int = self.rdepth;
    self.rstack[slot] = value;
    self.rdepth = self.rdepth + 1;
    return;
};

pro[exp] (Forth[mut, bor]) rpop(): int = {
    when(self.rdepth <= 0) {
        case(true) { self.fail("return stack underflow"); return 0; }
        * { }
    };
    self.rdepth = self.rdepth - 1;
    var slot: int = self.rdepth;
    return self.rstack[slot];
};

// MEMORY ---------------------------------------------------------------------

// One address space out of three pages: the page boundary is invisible to
// every word above this line, which is the point.
pro[exp] (Forth[mut, bor]) fetch(addr: int): int = {
    when((addr < 0) or (addr >= words::MEM_CELLS)) {
        case(true) { self.fail("address out of range"); return 0; }
        * { }
    };
    when(addr < words::PAGE_ONE) {
        case(true) { return self.page0[addr]; }
        * { }
    };
    when(addr < words::PAGE_TWO) {
        case(true) {
            var slot: int = addr - words::PAGE_ONE;
            return self.page1[slot];
        }
        * { }
    };
    var slot: int = addr - words::PAGE_TWO;
    return self.page2[slot];
};

pro[exp] (Forth[mut, bor]) store(addr: int, value: int): non = {
    when((addr < 0) or (addr >= words::MEM_CELLS)) {
        case(true) { self.fail("address out of range"); return; }
        * { }
    };
    when(addr < words::PAGE_ONE) {
        case(true) { self.page0[addr] = value; return; }
        * { }
    };
    when(addr < words::PAGE_TWO) {
        case(true) {
            var low: int = addr - words::PAGE_ONE;
            self.page1[low] = value;
            return;
        }
        * { }
    };
    var high: int = addr - words::PAGE_TWO;
    self.page2[high] = value;
    return;
};

// `,` -- append one cell at HERE and step HERE past it.
pro[exp] (Forth[mut, bor]) comma(value: int): non = {
    var here: int = self.fetch(words::ADDR_HERE);
    when(here >= words::MEM_CELLS) {
        case(true) { self.fail("data segment full"); return; }
        * { }
    };
    self.store(here, value);
    self.store(words::ADDR_HERE, here + 1);
    return;
};

// jonesforth's flags byte holds F_IMMED, F_HIDDEN and the name length together
// and toggles a flag with `xorb`. Without bitwise operators the bit is read out
// with `/` and `%` and toggled by adding or subtracting its weight.
pro[exp] (Forth[mut, bor]) toggle_flag(header: int, bit: int): non = {
    var field: int = self.fetch(header + 1);
    var lit: int = (field / bit) % 2;
    var[mut] next_field: int = field + bit;
    when(lit == 1) {
        case(true) { next_field = field - bit; }
        * { }
    };
    self.store(header + 1, next_field);
    return;
};

// INPUT ----------------------------------------------------------------------

// KEY: one byte, or -1 once the buffer is spent. jonesforth exits the process
// at that point; here the outer interpreter simply stops.
pro[exp] (Forth[mut, bor]) key(): int = {
    when(self.cursor >= .len(self.input)) {
        case(true) { return -1; }
        * { }
    };
    var code: int = std::strn::byte_at(self.input, self.cursor);
    self.cursor = self.cursor + 1;
    return code;
};

// The first half of _WORD: run past blanks, and past `\` comments to the end of
// their line, and hand back the first character that begins a word.
pro[exp] (Forth[mut, bor]) skip_blanks(): int = {
    var[mut] code: int = self.key();
    var[mut] scanning: bol = true;
    loop (scanning) {
        when(code < 0) {
            case(true) { scanning = false; }
            * {
                when(text::is_comment(code)) {
                    case(true) {
                        var[mut] inside: int = code;
                        loop ((inside >= 0) and (text::is_newline(inside) == false)) {
                            inside = self.key();
                        };
                        code = self.key();
                    }
                    * {
                        when(text::is_blank(code)) {
                            case(true) { code = self.key(); }
                            * { scanning = false; }
                        };
                    }
                };
            }
        };
    };
    return code;
};

// _WORD proper: fill the static word buffer and record its length.
pro[exp] (Forth[mut, bor]) read_word(): non = {
    var[mut] code: int = self.skip_blanks();
    self.word_len = 0;
    when(code < 0) {
        case(true) { self.eof = true; return; }
        * { }
    };
    loop ((code >= 0) and (text::is_blank(code) == false)) {
        when(self.word_len < words::WORDBUF_CELLS) {
            case(true) {
                var slot: int = words::ADDR_WORDBUF + self.word_len;
                self.store(slot, code);
                self.word_len = self.word_len + 1;
            }
            * { }
        };
        code = self.key();
    };
    return;
};

// The text sitting in the word buffer, used only for reporting.
pro[exp] (Forth[mut, bor]) word_text(): str = {
    var[mut] out: str = "";
    var[mut] i: int = 0;
    loop (i < self.word_len) {
        var code: int = self.fetch(words::ADDR_WORDBUF + i);
        out = out + std::strn::from_byte(code);
        i = i + 1;
    };
    return out;
};

// _NUMBER: parse the word buffer in the current BASE. `num_left` counts the
// characters that could not be converted, so zero means a clean parse.
pro[exp] (Forth[mut, bor]) number(addr: int, len: int): non = {
    self.num_value = 0;
    self.num_left = len;
    when(len <= 0) {
        case(true) { return; }
        * { }
    };
    var base: int = self.fetch(words::ADDR_BASE);
    var first: int = self.fetch(addr);
    var[mut] negative: bol = false;
    var[mut] i: int = 0;
    when(text::is_minus(first)) {
        case(true) { negative = true; i = 1; }
        * { }
    };
    when(i >= len) {
        case(true) { self.num_left = 1; return; }
        * { }
    };
    var[mut] total: int = 0;
    var[mut] bad: bol = false;
    loop ((i < len) and (bad == false)) {
        var code: int = self.fetch(addr + i);
        var value: int = text::digit_value(code, base);
        when(value < 0) {
            case(true) { bad = true; }
            * {
                total = (total * base) + value;
                i = i + 1;
            }
        };
    };
    when(bad) {
        case(true) { self.num_left = len - i; return; }
        * { }
    };
    self.num_left = 0;
    when(negative) {
        case(true) { total = -total; }
        * { }
    };
    self.num_value = total;
    return;
};

// DICTIONARY -----------------------------------------------------------------
//
// One entry, laid out the way jonesforth lays it out, one byte per cell:
//
//   header+0        link to the previous entry, -1 ends the chain
//   header+1        flags + name length in a single field
//   header+2 ..     the name, one character per cell
//   header+2+len    the codeword                      <- >CFA lands here
//   header+3+len    the body                          <- >DFA lands here

pro[exp] (Forth[mut, bor]) to_cfa(header: int): int = {
    var field: int = self.fetch(header + 1);
    return header + 2 + (field % words::LEN_MOD);
};

// _FIND. Masking the flags field with F_HIDDEN|F_LENMASK is jonesforth's trick
// for skipping hidden entries: a hidden word's length reads back 32 too high
// and can never match a real one.
pro[exp] (Forth[mut, bor]) find_at(addr: int, len: int): int = {
    var[mut] current: int = self.fetch(words::ADDR_LATEST);
    loop (current >= 0) {
        var masked: int = self.fetch(current + 1) % words::HIDDEN_MOD;
        when(masked == len) {
            case(true) {
                var[mut] i: int = 0;
                var[mut] same: bol = true;
                loop ((i < len) and same) {
                    var here: int = self.fetch(current + 2 + i);
                    var there: int = self.fetch(addr + i);
                    when(here == there) {
                        case(true) { i = i + 1; }
                        * { same = false; }
                    };
                };
                when(same) {
                    case(true) { return current; }
                    * { }
                };
            }
            * { }
        };
        current = self.fetch(current);
    };
    return -1;
};

// CREATE: build a header out of the name sitting at `addr`, and relink LATEST.
// Like jonesforth's CREATE it stops short of the codeword, which `:` writes.
pro[exp] (Forth[mut, bor]) create_entry(addr: int, len: int): non = {
    var here: int = self.fetch(words::ADDR_HERE);
    var link: int = self.fetch(words::ADDR_LATEST);
    self.comma(link);
    self.comma(len);
    var[mut] i: int = 0;
    loop (i < len) {
        var code: int = self.fetch(addr + i);
        self.comma(code);
        i = i + 1;
    };
    self.store(words::ADDR_LATEST, here);
    return;
};

// The assembler-time twin of CREATE, standing in for the defcode/defword
// macros: it writes the codeword too, so the entry is complete.
pro[exp] (Forth[mut, bor]) def_header(name: str, flags: int, code: int): non = {
    var here: int = self.fetch(words::ADDR_HERE);
    var link: int = self.fetch(words::ADDR_LATEST);
    var len: int = .len(name);
    self.comma(link);
    self.comma(flags + len);
    var[mut] i: int = 0;
    loop (i < len) {
        var byte: int = std::strn::byte_at(name, i);
        self.comma(byte);
        i = i + 1;
    };
    self.comma(code);
    self.store(words::ADDR_LATEST, here);
    return;
};

// WORD FIND >CFA in one step, for code that already holds the name as text.
pro[exp] (Forth[mut, bor]) lookup(name: str): int = {
    var len: int = .len(name);
    var[mut] i: int = 0;
    loop (i < len) {
        var byte: int = std::strn::byte_at(name, i);
        var slot: int = words::ADDR_WORDBUF + i;
        self.store(slot, byte);
        i = i + 1;
    };
    var header: int = self.find_at(words::ADDR_WORDBUF, len);
    when(header < 0) {
        case(true) { self.fail("undefined word: " + name); return -1; }
        * { }
    };
    return self.to_cfa(header);
};

// `' NAME ,` -- append the codeword of an existing word.
pro[exp] (Forth[mut, bor]) compile(name: str): non = {
    var cfa: int = self.lookup(name);
    self.comma(cfa);
    return;
};

// INNER INTERPRETER ----------------------------------------------------------

// NEXT. Fetch the codeword the instruction pointer names, step past it, and
// either enter the definition (DOCOL) or run the primitive.
pro[exp] (Forth[mut, bor]) step(): non = {
    var here: int = self.ip;
    var cfa: int = self.fetch(here);
    self.ip = self.ip + 1;
    var code: int = self.fetch(cfa);
    when(code == words::DOCOL) {
        case(true) {
            var caller: int = self.ip;
            self.rpush(caller);
            self.ip = cfa + 1;
            return;
        }
        * { }
    };
    self.exec(code);
    return;
};

// Thread one word. The two trampoline cells hold the word and then HALT, which
// is the same shape as jonesforth entering a word from inside QUIT and landing
// back in QUIT's loop when the word EXITs.
pro[exp] (Forth[mut, bor]) run_cfa(cfa: int): non = {
    self.store(words::ADDR_TRAMPOLINE, cfa);
    var stop: int = self.halt_cfa;
    var stop_slot: int = words::ADDR_TRAMPOLINE + 1;
    self.store(stop_slot, stop);
    self.ip = words::ADDR_TRAMPOLINE;
    self.halted = false;
    var[mut] fuel: int = words::STEP_LIMIT;
    loop ((self.halted == false) and (self.fault == "") and (fuel > 0)) {
        self.step();
        fuel = fuel - 1;
    };
    when(fuel <= 0) {
        case(true) { self.fail("runaway execution"); }
        * { }
    };
    return;
};

pro[exp] (Forth[mut, bor]) exec(code: int): non = {
    when(code) {
        is(words::P_DROP) { self.drop_top(); }
        is(words::P_SWAP) {
            var top: int = self.pop();
            var below: int = self.pop();
            self.push(top);
            self.push(below);
        }
        is(words::P_DUP) {
            var top: int = self.peek(0);
            self.push(top);
        }
        is(words::P_OVER) {
            var below: int = self.peek(1);
            self.push(below);
        }
        is(words::P_ROT) {
            var third: int = self.pop();
            var second: int = self.pop();
            var first: int = self.pop();
            self.push(second);
            self.push(third);
            self.push(first);
        }
        is(words::P_DIVMOD) {
            var divisor: int = self.pop();
            var dividend: int = self.pop();
            when(divisor == 0) {
                case(true) { self.fail("division by zero"); return; }
                * { }
            };
            self.push(dividend % divisor);
            self.push(dividend / divisor);
        }
        is(words::P_ADD) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push(left + right);
        }
        is(words::P_SUB) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push(left - right);
        }
        is(words::P_MUL) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push(left * right);
        }
        is(words::P_EQU) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left == right);
        }
        is(words::P_NEQU) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left != right);
        }
        is(words::P_LT) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left < right);
        }
        is(words::P_GT) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left > right);
        }
        is(words::P_LE) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left <= right);
        }
        is(words::P_GE) {
            var right: int = self.pop();
            var left: int = self.pop();
            self.push_flag(left >= right);
        }
        is(words::P_ZEQU) {
            var top: int = self.pop();
            self.push_flag(top == 0);
        }
        is(words::P_EXIT) {
            var back: int = self.rpop();
            self.ip = back;
        }
        is(words::P_LIT) {
            var here: int = self.ip;
            var value: int = self.fetch(here);
            self.ip = self.ip + 1;
            self.push(value);
        }
        is(words::P_STORE) {
            var addr: int = self.pop();
            var value: int = self.pop();
            self.store(addr, value);
        }
        is(words::P_FETCH) {
            var addr: int = self.pop();
            var value: int = self.fetch(addr);
            self.push(value);
        }
        is(words::P_STATE) { self.push(words::ADDR_STATE); }
        is(words::P_HERE) { self.push(words::ADDR_HERE); }
        is(words::P_LATEST) { self.push(words::ADDR_LATEST); }
        is(words::P_BASE) { self.push(words::ADDR_BASE); }
        is(words::P_WORD) {
            self.read_word();
            self.push(words::ADDR_WORDBUF);
            var len: int = self.word_len;
            self.push(len);
        }
        is(words::P_FIND) {
            var len: int = self.pop();
            var addr: int = self.pop();
            var header: int = self.find_at(addr, len);
            self.push(header);
        }
        is(words::P_TCFA) {
            var header: int = self.pop();
            var cfa: int = self.to_cfa(header);
            self.push(cfa);
        }
        is(words::P_CREATE) {
            var len: int = self.pop();
            var addr: int = self.pop();
            self.create_entry(addr, len);
        }
        is(words::P_COMMA) {
            var value: int = self.pop();
            self.comma(value);
        }
        is(words::P_LBRAC) { self.store(words::ADDR_STATE, 0); }
        is(words::P_RBRAC) { self.store(words::ADDR_STATE, 1); }
        is(words::P_HIDDEN) {
            var header: int = self.pop();
            self.toggle_flag(header, words::F_HIDDEN);
        }
        is(words::P_IMMEDIATE) {
            var header: int = self.fetch(words::ADDR_LATEST);
            self.toggle_flag(header, words::F_IMMED);
        }
        is(words::P_BRANCH) {
            var here: int = self.ip;
            var offset: int = self.fetch(here);
            self.ip = self.ip + offset;
        }
        is(words::P_ZBRANCH) {
            var flag: int = self.pop();
            when(flag == 0) {
                case(true) {
                    var here: int = self.ip;
                    var offset: int = self.fetch(here);
                    self.ip = self.ip + offset;
                }
                * { self.ip = self.ip + 1; }
            };
        }
        is(words::P_TICK) {
            var here: int = self.ip;
            var value: int = self.fetch(here);
            self.ip = self.ip + 1;
            self.push(value);
        }
        is(words::P_DOT) {
            var value: int = self.pop();
            var base: int = self.fetch(words::ADDR_BASE);
            self.emit(text::render(value, base) + " ");
        }
        is(words::P_EMIT) {
            var code_point: int = self.pop();
            self.emit(std::strn::from_byte(code_point));
        }
        is(words::P_CR) { self.emit("\n"); }
        is(words::P_SPACE) { self.emit(" "); }
        is(words::P_DEPTH) {
            var depth: int = self.depth;
            self.push(depth);
        }
        is(words::P_HALT) { self.halted = true; }
        * { self.fail("unknown codeword"); }
    };
    return;
};

// OUTER INTERPRETER ----------------------------------------------------------

// jonesforth prints the message and then up to forty characters of whatever it
// had already consumed, which is what `text::tail` reproduces.
pro[exp] (Forth[mut, bor]) parse_error(): non = {
    var context: str = text::tail(self.input, self.cursor, 40);
    self.emit("PARSE ERROR: " + context + "\n");
    return;
};

// INTERPRET: read a word, look it up, and either run it or compile it. An
// immediate word runs even while compiling, and that single exception is what
// makes `;`, IF, ELSE and THEN possible.
pro[exp] (Forth[mut, bor]) interpret(): non = {
    self.read_word();
    when(self.eof) {
        case(true) { return; }
        * { }
    };

    var len: int = self.word_len;
    var header: int = self.find_at(words::ADDR_WORDBUF, len);
    var[mut] is_literal: bol = false;
    var[mut] immediate: bol = false;
    var[mut] cfa: int = 0;
    var[mut] value: int = 0;

    when(header >= 0) {
        case(true) {
            var flags: int = self.fetch(header + 1);
            immediate = ((flags / words::F_IMMED) % 2) == 1;
            cfa = self.to_cfa(header);
        }
        * {
            is_literal = true;
            self.number(words::ADDR_WORDBUF, len);
            when(self.num_left > 0) {
                case(true) { self.parse_error(); return; }
                * { }
            };
            value = self.num_value;
            cfa = self.lit_cfa;
        }
    };

    var state: int = self.fetch(words::ADDR_STATE);
    when((state == 1) and (immediate == false)) {
        case(true) {
            self.comma(cfa);
            when(is_literal) {
                case(true) { self.comma(value); }
                * { }
            };
            return;
        }
        * { }
    };
    when(is_literal) {
        case(true) { self.push(value); return; }
        * { }
    };
    self.run_cfa(cfa);
    return;
};

// QUIT: clear the return stack and interpret until the input runs out.
pro[exp] (Forth[mut, bor]) quit(script: str): non = {
    self.input = script;
    self.cursor = 0;
    self.eof = false;
    self.rdepth = 0;
    loop ((self.eof == false) and (self.fault == "")) {
        self.interpret();
    };
    return;
};
