use std: pkg = {"std"};

// Instruction set for the stack machine.
// Every instruction is one opcode plus one immediate; instructions that take
// no immediate simply ignore `arg`.
typ[exp] Op: ent = {
    var PUSH: int = 0;
    var ADD: int = 1;
    var SUB: int = 2;
    var MUL: int = 3;
    var DIV: int = 4;
    var DUP: int = 5;
    var DROP: int = 6;
    var SWAP: int = 7;
    var PRINT: int = 8;
    var HALT: int = 9;
};

typ[exp] Instr: rec = {
    op: int;
    arg: int
};

fun[exp] op_name(op: int): str = {
    when(op) {
        is(0) { return "push"; }
        is(1) { return "add"; }
        is(2) { return "sub"; }
        is(3) { return "mul"; }
        is(4) { return "div"; }
        is(5) { return "dup"; }
        is(6) { return "drop"; }
        is(7) { return "swap"; }
        is(8) { return "print"; }
        is(9) { return "halt"; }
        * { return "bad"; }
    }
};

// How many operands the instruction pops before it runs.
fun[exp] arity(op: int): int = {
    when(op) {
        is(1) { return 2; }
        is(2) { return 2; }
        is(3) { return 2; }
        is(4) { return 2; }
        is(5) { return 1; }
        is(6) { return 1; }
        is(7) { return 2; }
        is(8) { return 1; }
        * { return 0; }
    }
};

fun[exp] show(ins: Instr): str = {
    when(ins.op) {
        is(0) { return "push " + std::fmt::int_to_str(ins.arg); }
        * { return op_name(ins.op); }
    }
};
