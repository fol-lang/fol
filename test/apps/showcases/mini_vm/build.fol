pro[] build(): non = {
    var build = .build();
    build.meta({ name = "mini_vm", version = "0.1.0" });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({ name = "mini-vm", root = "src/main.fol", fol_model = "memo" });
    graph.install(app);
    graph.add_run(app);
    var tests = graph.add_test({ name = "mini-vm-test", root = "test/main.fol", fol_model = "memo" });
    return;
};
