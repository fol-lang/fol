// Everything CHIP-8 does at the bit level.
//
// The three logic opcodes (8XY1/8XY2/8XY3) and the sprite XOR in DXYN call
// `.bit_or`/`.bit_and`/`.bit_xor` directly, so this module is only the named
// masks and shifts the interpreter reads opcodes through.

// Bit `index` of `value`, counting 0 from the least significant end.
fun[exp] bit_at(value: int, index: int): int = {
    return .bit_and(.shr(value, index), 1);
};

// The two shifts 8XY6 and 8XYE need, plus the bits they spill into VF.
fun[exp] shift_right(value: int): int = {
    return .shr(value, 1);
};

fun[exp] shift_left8(value: int): int = {
    return .bit_and(.shl(value, 1), 0xFF);
};

fun[exp] low_bit(value: int): int = {
    return .bit_and(value, 1);
};

fun[exp] top_bit(value: int): int = {
    return .bit_and(.shr(value, 7), 1);
};

// 8-bit register wrap-around. FOL's `%` keeps the sign of its left operand, so
// a borrowing subtraction has to be lifted back into 0..255 by hand.
fun[exp] wrap_byte(value: int): int = {
    return ((value % 256) + 256) % 256;
};

// Opcode field extraction, spelled as the C original spells it: mask the field
// out, then shift it down to its own low bits.
fun[exp] group(op: int): int = {
    return .shr(.bit_and(op, 0xF000), 12);
};

fun[exp] reg_x(op: int): int = {
    return .shr(.bit_and(op, 0x0F00), 8);
};

fun[exp] reg_y(op: int): int = {
    return .shr(.bit_and(op, 0x00F0), 4);
};

fun[exp] nibble(op: int): int = {
    return .bit_and(op, 0x000F);
};

fun[exp] byte_lo(op: int): int = {
    return .bit_and(op, 0x00FF);
};

fun[exp] addr(op: int): int = {
    return .bit_and(op, 0x0FFF);
};
