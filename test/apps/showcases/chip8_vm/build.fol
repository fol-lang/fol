pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "chip8_vm", version = "0.1.0", kind = "exe",
        description = "CHIP-8 virtual machine with arithmetic-only bit operations",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var app = graph.add_exe({
        name = "chip8_vm", root = "src/main.fol", fol_model = "memo",
        target = target, optimize = optimize,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
