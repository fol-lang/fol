// Build description for the config-parser package.
//
// The test root lives in its own namespace directory (`src/tests/lib.fol`):
// two source files in one namespace cannot both declare `use std`, and cannot
// both hold a `main`.
//
// Comments only appear above the routine on purpose -- a `//` comment inside
// the `build()` body makes build evaluation fail with F1001.

pro[] build(): non = {
    var build = .build();
    build.meta({ name = "config_parser", version = "0.1.0" });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({
        name = "config-parser",
        root = "src/main.fol",
        fol_model = "memo",
    });
    graph.install(app);
    graph.add_run(app);
    graph.add_test({
        name = "config-parser-tests",
        root = "src/tests/lib.fol",
        fol_model = "memo",
    });
    return;
};
