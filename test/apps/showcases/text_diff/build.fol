// Build description for the text-diff package.
//
// The self-checks live inside the executable rather than in a `graph.add_test`
// artifact: a second artifact root that imports a namespace declaring a
// standard fails to build, and `src/lcs` declares the `keyed` standard.
//
// Comments only appear above the routine on purpose -- a `//` comment between
// statements inside the `build()` body makes build evaluation fail with F1001.

pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "text_diff",
        version = "0.1.0",
        kind = "exe",
        description = "line-oriented diff with a generic LCS core",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var app = graph.add_exe({
        name = "text_diff",
        root = "src/main.fol",
        fol_model = "memo",
        target = target,
        optimize = optimize,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
