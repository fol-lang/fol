pro[] build(): non = {
    var build = .build();
    build.meta({
        name = "maze_solver",
        version = "0.1.0",
        kind = "exe",
        description = "breadth-first and depth-first grid pathfinding",
        license = "MIT",
    });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var target = graph.standard_target();
    var optimize = graph.standard_optimize();
    var app = graph.add_exe({
        name = "maze_solver",
        root = "src/main.fol",
        fol_model = "memo",
        target = target,
        optimize = optimize,
    });
    graph.install(app);
    graph.add_run(app);
    return;
};
