// The transport -- mini-redis `src/server.rs`.
//
// The original accepts TCP connections and spawns one `Handler` per socket,
// every handler holding a clone of the same `Db`, and so does this: `serve_all`
// binds a loopback port, `.tcp_accept` hands back one socket per client, and each
// gets a `[spn]` task that frames a request off the wire, dispatches it against
// the shared `mux[Store]`, and writes the reply back into the socket.
//
// The clients run in this process too, which is what keeps the run self-checking:
// the port is ephemeral (`127.0.0.1:0`), and the reply counts the checks assert on
// do not depend on the order the three connections interleave.

use std: pkg = {"std"};
use resp: loc = {"../resp"};
use store: loc = {"../store"};
use command: loc = {"../command"};

con[exp] CLIENTS: int = 3;
con[exp] OPS: int = 3;

typ[exp] Reply: rec = {
    client: int,
    step: int,
    wire: str,
};

typ[exp] Tally: rec = {
    replies: int,
    oks: int,
    bulks: int,
    errors: int,
    started: int,
};

fun[exp] empty(): Tally = {
    return { replies = 0, oks = 0, bulks = 0, errors = 0, started = 0 };
};

// Client `id`'s key space. Distinct per client, so a lost update shows up as a
// missing key at the end rather than as a scrambled value.
fun[exp] key_of(id: int, step: int): str = {
    return "c" + std::fmt::int_to_str(id) + ":k" + std::fmt::int_to_str(step);
};

fun[exp] value_of(id: int, step: int): str = {
    return "v" + std::fmt::int_to_str((id * 10) + step);
};

// Hand one reply back. A send yields a must-handle `err[T]` whose present
// branch owns a payload nobody will receive, so `false` means the reader has
// gone -- the analogue of a client hanging up mid-reply.
fun deliver(out: chn[tx, Reply], message: Reply): bol = {
    var[mut] accepted: bol = true;
    var sent: err[Reply] = message | out;
    when (sent) {
        on (unsent) { accepted = false; }
        * { accepted = true; }
    };
    return accepted;
};

// One framed read, the original's `Connection::read_frame`. A single `.tcp_read`
// returns whatever happened to arrive, so bytes are pulled until `decode_at`
// stops answering INCOMPLETE. Whatever followed the frame stays in `rest`.
typ[exp] Framed: rec = {
    ok: bol,
    wire: str,
    rest: str,
};

fun[exp] read_frame(sock: int, buffered: str): Framed = {
    var[mut] buffer: str = buffered;
    var[mut] scanning: bol = true;
    loop (scanning) {
        var seen: resp::Decoded = resp::decode_at(buffer, 0);
        when (seen.ok) {
            case(true) {
                var span: int = .len(buffer) - seen.upto;
                return {
                    ok = true,
                    wire = std::strn::sub(buffer, 0, seen.upto),
                    rest = std::strn::sub(buffer, seen.upto, span),
                };
            }
            * { }
        };
        when (seen.fault != resp::INCOMPLETE) {
            case(true) { scanning = false; }
            * {
                var chunk: str = .tcp_read(sock);
                when (.len(chunk) == 0) {
                    case(true) { scanning = false; }
                    * { buffer = buffer + chunk; }
                };
            }
        };
    };
    return { ok = false, wire = "", rest = buffer };
};

// One accepted socket, the original's `Handler::run`: frame a request, dispatch
// it against the shared store, write the reply, until the peer hangs up. Runs on
// its own OS thread, contending with the others for the same store handle.
fun[exp] connection(state: mux[store::Store], sock: int, now: int): int = {
    var[mut] rest: str = "";
    var[mut] served: int = 0;
    var[mut] open: bol = true;
    loop (open) {
        var framed: Framed = read_frame(sock, rest);
        when (framed.ok) {
            case(true) {
                rest = framed.rest;
                var reply: str = command::serve(framed.wire, state, now);
                var wrote: int = .tcp_write(sock, reply);
                when (wrote < 0) {
                    case(true) { open = false; }
                    * { served = served + 1; }
                };
            }
            * { open = false; }
        };
    };
    var closed: int = .tcp_close(sock);
    return served;
};

// One client, over a real socket. Sends the same SET/GET pairs and closing DEL
// the in-process fan-out used to send, and reports each reply it reads back.
fun[exp] client(out: chn[tx, Reply], notes: chn[tx, int], addr: str, id: int): int = {
    var sock: int = .tcp_connect(addr);
    when (sock < 0) {
        case(true) { return 0; }
        * { }
    };
    var announced: err[int] = 1 | notes;
    var[mut] rest: str = "";
    var[mut] step: int = 0;
    var[mut] sent: int = 0;
    var[mut] live: bol = true;
    loop (live and (step < OPS)) {
        var key: str = key_of(id, step);

        var wrote_req: int = .tcp_write(sock, command::wire_of("SET", key, value_of(id, step), "", "", 2));
        var write_framed: Framed = read_frame(sock, rest);
        rest = write_framed.rest;

        var read_req: int = .tcp_write(sock, command::wire_of("GET", key, "", "", "", 1));
        var read_framed: Framed = read_frame(sock, rest);
        rest = read_framed.rest;

        when (write_framed.ok and read_framed.ok) {
            case(true) {
                var wrote: bol = deliver(out, { client = id, step = step, wire = write_framed.wire });
                var read: bol = deliver(out, { client = id, step = step, wire = read_framed.wire });
                when (wrote and read) {
                    case(true) { sent = sent + 2; }
                    * { live = false; }
                };
            }
            * { live = false; }
        };
        step = step + 1;
    };

    // One key per client goes away again, so DEL is exercised under contention.
    when (live) {
        case(true) {
            var gone_req: int = .tcp_write(sock, command::wire_of("DEL", key_of(id, 0), "", "", "", 1));
            var gone_framed: Framed = read_frame(sock, rest);
            when (gone_framed.ok) {
                case(true) {
                    var gone: bol = deliver(out, { client = id, step = OPS, wire = gone_framed.wire });
                    when (gone) {
                        case(true) { sent = sent + 1; }
                        * { }
                    };
                }
                * { }
            };
        }
        * { }
    };
    var closed: int = .tcp_close(sock);
    return sent;
};

// Classify one reply by its leading byte, which is all a client needs to know.
fun[exp] absorb(seen: Tally, message: Reply): Tally = {
    var[mut] totals: Tally = seen;
    totals.replies = totals.replies + 1;
    var lead: int = std::strn::byte_at(message.wire, 0);
    when (lead == resp::PLUS) {
        case(true) { totals.oks = totals.oks + 1; }
        * { }
    };
    when (lead == resp::DOLLAR) {
        case(true) { totals.bulks = totals.bulks + 1; }
        * { }
    };
    when (lead == resp::MINUS) {
        case(true) { totals.errors = totals.errors + 1; }
        * { }
    };
    return totals;
};

// Drain every reply. The loop ends when the last handler drops its sender, so
// it doubles as the join point. The whole `chn[T]` is moved in: iterating an
// extracted endpoint blocks forever while the channel binding is still alive.
fun[exp] drain(inbox: chn[Reply]): Tally = {
    var[mut] totals: Tally = empty();
    for (message in inbox[rx]) {
        totals = absorb(totals, message);
    };
    return totals;
};

// Bind, fan the clients out, then accept one connection per client and give each
// its own task -- the original's `run` loop, with the store handle shared by
// every accepted socket.
fun[exp] serve_all(state: mux[store::Store], now: int): Tally = {
    var listener: int = .tcp_listen("127.0.0.1:0");
    var addr: str = .tcp_local_addr(listener);
    var replies: chn[Reply];
    var notes: chn[int];

    var[mut] id: int = 0;
    loop (id < CLIENTS) {
        [spn]client(replies[tx], notes[tx], addr, id);
        id = id + 1;
    };

    var[mut] taken: int = 0;
    loop (taken < CLIENTS) {
        var sock: int = .tcp_accept(listener);
        [spn]connection(state, sock, now);
        taken = taken + 1;
    };

    var[mut] totals: Tally = drain([mov]replies);

    // A first-class `chn[rx, int]` receiver endpoint. The `*` arm makes the
    // select non-blocking, so the count settles once the queue is empty
    // instead of waiting on senders that are already gone.
    var inbox: chn[rx, int] = notes[rx];
    var[mut] started: int = 0;
    var[mut] draining: bol = true;
    loop (draining) {
        select {
            when inbox as token {
                started = started + token;
            }
            * {
                draining = false;
            }
        };
    };
    totals.started = started;
    var closed: int = .tcp_close(listener);
    return totals;
};

// Render the run summary. Pure, so it is safe on its own thread.
fun[exp] compose(totals: Tally, alive: int, writes: int): str = {
    return "clients=" + std::fmt::int_to_str(totals.started)
    + " replies=" + std::fmt::int_to_str(totals.replies)
    + " ok=" + std::fmt::int_to_str(totals.oks)
    + " bulk=" + std::fmt::int_to_str(totals.bulks)
    + " err=" + std::fmt::int_to_str(totals.errors)
    + " keys=" + std::fmt::int_to_str(alive)
    + " writes=" + std::fmt::int_to_str(writes);
};

// The one-shot result of the run. The eventual crosses a routine signature, so
// its parent-scope lifetime `L` is spelled on both sides.
fun[exp] summarize(L: lif)(totals: Tally, alive: int, writes: int): evt[L, str] = {
    return compose(totals, alive, writes) | async;
};
