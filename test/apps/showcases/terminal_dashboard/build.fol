pro[] build(): non = {
    var build = .build();
    build.meta({ name = "terminal_dashboard", version = "0.1.0" });
    build.add_dep({ alias = "std", source = "internal", target = "standard" });
    var graph = build.graph();
    var app = graph.add_exe({
        name = "terminal-dashboard",
        root = "src/main.fol",
        fol_model = "memo",
    });
    graph.install(app);
    graph.add_run(app);
    var checks = graph.add_test({
        name = "terminal-dashboard-checks",
        root = "test/checks.fol",
        fol_model = "memo",
    });
    return;
};
