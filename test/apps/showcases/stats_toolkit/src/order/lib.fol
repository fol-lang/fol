// Selection sort, in place on a local copy.
//
// `out[head] = out[least]` writes an element directly, so the classic swap is
// the real thing rather than a rank computation standing in for one.
fun[exp] sorted(values: vec[flt]): vec[flt] = {
    var[mut] out: vec[flt] = [cpy]values;
    var[mut] head: int = 0;
    loop(head < .len(out)) {
        var[mut] least: int = head;
        var[mut] probe: int = head + 1;
        loop(probe < .len(out)) {
            when(out[probe] < out[least]) {
                case(true) { least = probe; }
                * { }
            }
            probe = probe + 1;
        }
        var keep: flt = out[head];
        out[head] = out[least];
        out[least] = keep;
        head = head + 1;
    }
    return out;
};

// The target-th smallest value.
fun[exp] nth_smallest(values: vec[flt], target: int): flt = {
    return sorted(values)[target];
};

fun[exp] smallest(values: vec[flt]): flt = {
    return nth_smallest(values, 0);
};

fun[exp] largest(values: vec[flt]): flt = {
    return nth_smallest(values, .len(values) - 1);
};

// Verifies the ordering is a real one: every consecutive pair must be
// non-decreasing.
fun[exp] is_ordered(values: vec[flt]): bol = {
    var ranked: vec[flt] = sorted(values);
    var[mut] index: int = 1;
    var[mut] ordered: bol = true;
    loop(index < .len(ranked)) {
        when(ranked[index] < ranked[index - 1]) {
            case(true) { ordered = false; }
            * { }
        }
        index = index + 1;
    }
    return ordered;
};
