use core: loc = {"../../../core/src/vocab"};
use std: pkg = {"std"};

// Summary rendering. This namespace only formats numbers that main.fol has
// already accumulated, so it stays free of any triage policy.

fun[hid] pad2(value: int): str = {
    when(.lt(value, 10)) {
        case(true) { return " " + std::fmt::int_to_str(value); }
        * { return std::fmt::int_to_str(value); }
    }
};

// Severity names are 4 or 5 bytes wide, so the shorter ones get one trailing
// space to keep the counts in a column.
fun[hid] pad_name(level: int): str = {
    var name: str = core::levels::name_of(level);
    loop(.lt(.len(name), 5)) {
        name = name + " ";
    }
    return name;
};

// One histogram row, e.g. `  ERROR  2 ##`.
fun[exp] histogram_row(level: int, count: int): str = {
    return "  " + pad_name(level) + " " + pad2(count) + " " + bars(count);
};

fun[hid] bars(count: int): str = {
    var out: str = "";
    var left: int = count;
    loop(.gt(left, 0)) {
        out = out + "#";
        left = left - 1;
    }
    return out;
};

// The counters line. Kept separate from the histogram so a caller can print
// one without the other.
fun[exp] totals_row(scanned: int, kept: int, malformed: int): str = {
    return "  scanned=" + std::fmt::int_to_str(scanned)
    + " kept=" + std::fmt::int_to_str(kept)
    + " dropped=" + std::fmt::int_to_str(scanned - kept)
    + " malformed=" + std::fmt::int_to_str(malformed);
};
